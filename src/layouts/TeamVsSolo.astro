---
// The layout of teamvssolo.providers.dev: providers.dev's header and footer, as on the two product sites, with Team vs
// Solo's mark (one large dot beside three small ones: one model, and a chief with workers) in place of
// providers.dev's. The pages are static and served at the subdomain's root, so every address here is root-relative on
// it. Only results the benchmark built from a clean commit are ever read (src/core/teamvssolo-data.ts).
import "../styles/global.css";
import "../styles/teamvssolo.css";
import { TEAMVSSOLO_SITE } from "../core/teamvssolo-site.ts";
import { jsonLdScript, type JsonLd } from "../core/structured-data.ts";

interface Props {
  title: string;
  description: string;
  /** The page's path on the subdomain; null for a page that has no address of its own (not found). */
  path: string | null;
  /** The page's structured data (src/core/structured-data.ts); none on a page with no address of its own. */
  jsonLd?: JsonLd[];
  /** The part of the site the page belongs to, marked in the navigation. */
  section?: "results" | "tests" | "method";
}
const { title, description, path, jsonLd, section } = Astro.props;
const canonical = path === null ? null : new URL(path, TEAMVSSOLO_SITE).toString();
const nav = [
  ["/results/", "Results", "results"],
  ["/tests/", "Tests", "tests"],
  ["/method/", "Method", "method"],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {canonical === null && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Team vs Solo" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${TEAMVSSOLO_SITE}/og.png`} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Team vs Solo by providers.dev: one model alone, or a chief with workers? A benchmark of coding models: score, price and time." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && jsonLd && <Fragment set:html={jsonLdScript(jsonLd)} />}
    {canonical && <link rel="alternate" type="text/markdown" href={`${canonical}index.html.md`} />}
    {canonical && <link rel="describedby" href={`${TEAMVSSOLO_SITE}/llms.txt`} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex flex-col tvs">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-bg focus:px-3 focus:py-2">Skip to content</a>
    <header class="site-header">
      <div class="tvs-page flex flex-wrap items-center gap-x-6 gap-y-1 py-2.5">
        <a href="/" class="brand tvs-brand" aria-label="Team vs Solo home">
          <svg class="mark" viewBox="0 0 20 24" aria-hidden="true"><circle cx="6" cy="12" r="5.5" fill="currentColor"></circle><g fill="var(--tvs)"><circle cx="16.5" cy="4.6" r="2.3"></circle><circle cx="16.5" cy="12" r="2.3"></circle><circle cx="16.5" cy="19.4" r="2.3"></circle></g></svg>
          <span>Team vs Solo</span>
          <span class="tvs-by">by providers.dev</span>
        </a>
        <nav aria-label="Main" class="nav order-3 flex w-full gap-1 overflow-x-auto sm:-mx-1 lg:order-none lg:mx-0 lg:w-auto lg:flex-1">
          {nav.map(([href, label, id]) => <a href={href} aria-current={section === id ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a class="button !h-[2.1rem]" href="https://providers.dev/">providers.dev</a>
          <button type="button" id="theme" class="icon-button" aria-label="Switch between light and dark theme" title="Switch theme">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer mt-16">
      <div class="tvs-page grid gap-8 py-8 sm:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <p class="brand tvs-brand !text-[0.95rem]">
            <svg class="mark" viewBox="0 0 20 24" aria-hidden="true"><circle cx="6" cy="12" r="5.5" fill="currentColor"></circle><g fill="var(--tvs)"><circle cx="16.5" cy="4.6" r="2.3"></circle><circle cx="16.5" cy="12" r="2.3"></circle><circle cx="16.5" cy="19.4" r="2.3"></circle></g></svg>
            <span>Team vs Solo</span>
            <span class="tvs-by">by providers.dev</span>
          </p>
          <p class="mt-3 max-w-md">
            Team vs Solo is a benchmark by <a href="https://providers.dev" class="underline">providers.dev</a>. Its method is public, and so are its results once a round is complete. providers.dev keeps its scoring checks private.
          </p>
        </div>
        <div>
          <h2>Team vs Solo</h2>
          <ul class="space-y-1">
            <li><a href="/results/">Results</a></li>
            <li><a href="/tests/">Tests</a></li>
            <li><a href="/method/">Method</a></li>
            <li><a href="/method/#limits">Limits</a></li>
          </ul>
        </div>
        <div>
          <h2>providers.dev</h2>
          <ul class="space-y-1">
            <li><a href="https://providers.dev">Model catalog</a></li>
            <li><a href="https://provimux.providers.dev/">Provimux</a></li>
            <li><a href="https://ngvoicu.dev/" rel="author">Gabriel Voicu</a></li>
            <li><a href="mailto:office@providers.dev">Contact</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      const button = document.getElementById("theme");
      button?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {
          // Private mode: the choice lasts for this page only.
        }
      });
    </script>
  </body>
</html>
