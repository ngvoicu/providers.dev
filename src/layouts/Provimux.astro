---
// The layout of provimux.providers.dev: providers.dev's header and footer, with Provimux's key in place of the mark.
// The pages are static and served at the subdomain's root, so every address here is root-relative on it.
import "../styles/global.css";
import "../styles/provimux.css";
import { PROVIMUX_SITE } from "../core/provimux-site.ts";
import { jsonLdScript, type JsonLd } from "../core/structured-data.ts";

interface Props {
  title: string;
  description: string;
  /** The page's path on the subdomain; null for a page that has no address of its own (not found). */
  path: string | null;
  /** The page's structured data (src/core/structured-data.ts); none on a page with no address of its own. */
  jsonLd?: JsonLd[];
}
const { title, description, path, jsonLd } = Astro.props;
const canonical = path === null ? null : new URL(path, PROVIMUX_SITE).toString();
const github = "https://github.com/ngvoicu/provimux";
const nav = [
  ["/#adds", "What it adds"],
  ["/#pools", "Pools"],
  ["/#console", "Console"],
  ["/#install", "Install"],
  ["/#pi", "Pi"],
  ["/support/", "Support"],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Provimux" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${PROVIMUX_SITE}/og.png`} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Provimux by providers.dev: One key for every AI account. Your subscriptions and API keys behind one endpoint, open to everyone you choose. Pools of models from every provider, with the prompt cache kept in use." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && jsonLd && <Fragment set:html={jsonLdScript(jsonLd)} />}
    {canonical && <link rel="alternate" type="text/markdown" href={`${canonical}index.html.md`} />}
    {canonical && <link rel="describedby" href={`${PROVIMUX_SITE}/llms.txt`} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex flex-col pmx">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-bg focus:px-3 focus:py-2">Skip to content</a>
    <header class="site-header">
      <div class="pmx-page flex flex-wrap items-center gap-x-6 gap-y-1 py-2.5">
        <a href="/" class="brand pmx-brand" aria-label="Provimux home">
          <svg class="mark" viewBox="10 4 16 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="4"><circle cx="18" cy="12" r="6"></circle><path d="M12 12v16"></path></g><path fill="currentColor" d="M12 22h6v2h-6zM12 26h8v2h-8z"></path><circle cx="18" cy="12" r="1.9" fill="var(--brand)"></circle></svg>
          <span>Provimux</span>
          <span class="pmx-by">by providers.dev</span>
        </a>
        <nav aria-label="Main" class="nav pmx-nav order-3 flex w-full gap-1 overflow-x-auto sm:-mx-1 lg:order-none lg:mx-0 lg:w-auto lg:flex-1">
          {nav.map(([href, label]) => <a href={href} aria-current={path !== null && href === path ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a class="button !h-[2.1rem]" href={github}>
            <svg class="pmx-gh" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            GitHub
          </a>
          <button type="button" id="theme" class="icon-button" aria-label="Switch between light and dark theme" title="Switch theme">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer mt-16">
      <div class="pmx-page grid gap-8 py-8 sm:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <p class="brand pmx-brand !text-[0.95rem]">
            <svg class="mark" viewBox="10 4 16 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="4"><circle cx="18" cy="12" r="6"></circle><path d="M12 12v16"></path></g><path fill="currentColor" d="M12 22h6v2h-6zM12 26h8v2h-8z"></path><circle cx="18" cy="12" r="1.9" fill="var(--brand)"></circle></svg>
            <span>Provimux</span>
            <span class="pmx-by">by providers.dev</span>
          </p>
          <p class="mt-3 max-w-md">
            Provimux, by <a href="https://providers.dev" class="underline">providers.dev</a>, is an open-source (MIT) distribution of <a href="https://github.com/router-for-me/CLIProxyAPI" class="underline">CLIProxyAPI</a> by router-for-me. It is not affiliated with or endorsed by Anthropic or OpenAI.
          </p>
        </div>
        <div>
          <h2>Provimux</h2>
          <ul class="space-y-1">
            <li><a href={github}>GitHub</a></li>
            <li><a href={`${github}/releases/latest`}>Latest release</a></li>
            <li><a href="https://github.com/ngvoicu/provimux-ui">The console, provimux-ui</a></li>
            <li><a href="https://github.com/ngvoicu/pi-provimux">pi-provimux</a></li>
          </ul>
        </div>
        <div>
          <h2>providers.dev</h2>
          <ul class="space-y-1">
            <li><a href="/support/">Support plans</a></li>
            <li><a href={`${github}/issues`}>Issues</a></li>
            <li><a href="https://providers.dev">Model catalog</a></li>
            <li><a href="mailto:office@providers.dev">Contact</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      const button = document.getElementById("theme");
      button?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {
          // Private mode: the choice lasts for this page only.
        }
      });
      // Copy buttons: the text of data-copy, then "Copied" for a moment.
      document.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-copy]");
        if (!target) return;
        navigator.clipboard.writeText(target.dataset.copy ?? "").then(() => {
          const before = target.textContent;
          target.textContent = "Copied";
          target.classList.add("done");
          setTimeout(() => {
            target.textContent = before;
            target.classList.remove("done");
          }, 1200);
        });
      });
    </script>
  </body>
</html>
