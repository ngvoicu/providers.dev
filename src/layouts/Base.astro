---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import { MARK } from "../core/page-shell.ts";

interface Props {
  /** The full title, " · providers.dev" included: the page shell's marker, filled by src/core/pages.ts (src/core/page-meta.ts). */
  title: string;
  description?: string;
}
const { title, description = "A reference for AI models as each provider and access method actually exposes them: context, output and prompt-cache behaviour, with sources." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="providers.dev" />
    <Fragment set:html={MARK.head} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="providers.dev: AI models as each provider actually exposes them. Context window, maximum output and prompt cache, for every provider and access method." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-bg focus:px-3 focus:py-2">Skip to content</a>
    <header class="site-header">
      <div class="page flex flex-wrap items-center gap-x-6 gap-y-1 py-2.5">
        <a href="/" class="brand" aria-label="providers.dev home">
          <Mark />
          <span>providers<span class="text-muted">.dev</span></span>
        </a>
        <nav aria-label="Main" class="nav order-3 grid w-full grid-cols-3 gap-1 overflow-x-auto sm:-mx-1 sm:flex lg:order-none lg:mx-0 lg:w-auto lg:flex-1">
          <Fragment set:html={MARK.nav} />
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a class="button !h-[2.1rem]" href="/api.json"><code>/api.json</code></a>
          <button type="button" id="theme" class="icon-button" aria-label="Switch between light and dark theme" title="Switch theme">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="page flex-1 py-8 sm:py-10">
      <slot />
    </main>

    <footer class="site-footer mt-12">
      <div class="page grid gap-8 py-8 sm:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <p class="brand !text-[0.95rem]">
            <Mark />
            <span>providers<span class="text-muted">.dev</span></span>
          </p>
          <p class="mt-3 max-w-md">
            Model metadata per provider and access method. The baseline is imported from <a href="https://models.dev" class="underline">models.dev</a> (MIT, © 2025 models.dev);
            the model catalog of <a href="https://pi.dev/models" class="underline">Pi</a> (MIT) is shown beside it. providers.dev is independent and is not affiliated with or
            endorsed by models.dev, Pi or any listed provider.
          </p>
        </div>
        <div>
          <h2>Dataset</h2>
          <ul class="space-y-1" set:html={MARK.dataset} />
        </div>
        <div>
          <h2>Reference</h2>
          <ul class="space-y-1">
            <li><a href="/docs/api/">API documentation</a></li>
            <li><a href="/api/v1/openapi.json">OpenAPI document</a></li>
            <li><a href="/docs/methodology/">Methodology</a></li>
            <li><a href="/docs/licensing/">Licensing and attribution</a></li>
            <li><a href="/docs/contributing/">Contributing</a></li>
            <li><a href="https://provimux.providers.dev/">Provimux</a></li>
            <li><a href="https://provimux.providers.dev/support/">Provimux support</a></li>
            <li><a href="https://pi-cache-keeper.providers.dev/">pi-cache-keeper</a></li>
            <li><a href="https://ngvoicu.dev/" rel="author">Gabriel Voicu</a></li>
            <li><a href="mailto:office@providers.dev">Contact</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      import "../client/warnings.ts";
      const button = document.getElementById("theme");
      button?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {
          // Private mode: the choice lasts for this page only.
        }
      });
      // One handler for every copy button on the page, including rows rendered later.
      document.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-copy]");
        if (!target) return;
        const value = target.dataset.copy ?? "";
        const text = value.startsWith("/api/") ? location.origin + value : value;
        navigator.clipboard.writeText(text).then(() => {
          const before = target.textContent;
          target.textContent = "Copied";
          target.classList.add("done");
          setTimeout(() => {
            target.textContent = before;
            target.classList.remove("done");
          }, 1200);
        });
      });
    </script>
  </body>
</html>
