---
// Everything providers.dev adds. The evaluations are the answer of GET /api/v1/evaluations; each cache evaluation is
// drawn with the same cells as the summary tables, from the results the API gives.
import Base from "../../layouts/Base.astro";
import { settingsText } from "../../core/cache.ts";
import { entryHref, exact, isStale, STALE_AFTER_DAYS } from "../../core/format.ts";
import { evaluationStrip, STRIP_HEAD } from "../../core/render.ts";
import { ext, type Evidence, type Provenance } from "../../core/schema.ts";
import { catalog, evaluations, index, meta, now } from "../../lib/data.ts";

const runs = evaluations.filter((item) => item.kind === "cache");
const limits = evaluations.filter((item) => item.kind === "limit");
const groups = new Map<string, { change: Provenance; refs: string[] }>();
for (const entry of index.entries) {
  if (entry.overridden_fields.length === 0) continue;
  for (const change of ext(catalog[entry.provider]!.models[entry.model]!).provenance ?? []) {
    const key = JSON.stringify([entry.provider, change.path, change.op, change.value, change.reason]);
    const group = groups.get(key) ?? groups.set(key, { change, refs: [] }).get(key)!;
    group.refs.push(entry.ref);
  }
}
const added = index.providers.filter((provider) => provider.origin === "added");
const staleRuns = runs.filter((item) => isStale(item.date, now)).length;
const host = (item: Evidence): string => new URL(item.url).hostname;
---

<Base title="Evidence" description="Everything providers.dev adds to models.dev: added providers, corrections and cache evaluations, each with its source and date.">
  <h1>Evidence</h1>
  <p class="lead mt-3">
    Everything providers.dev publishes beyond the models.dev baseline, with the source and date of each item. Evidence older than {STALE_AFTER_DAYS} days is marked stale{staleRuns > 0 ? <> ({exact(staleRuns)} evaluations today)</> : <> (none today)</>}.
  </p>
  <dl class="stats mt-8">
    <div><dt>Corrected entries</dt><dd>{exact(meta.counts.corrected_entries)} <small><a href="#corrections">Corrections</a></small></dd></div>
    <div><dt>Added providers</dt><dd>{exact(meta.counts.added_providers)} <small><a href="#added">{exact(meta.counts.added_entries)} entries</a></small></dd></div>
    <div><dt>Cache evaluations</dt><dd>{exact(meta.counts.cache_evaluations)} <small><a href="#cache">On {exact(meta.counts.evaluated_entries)} entries</a></small></dd></div>
    <div><dt>Measured limits</dt><dd>{exact(meta.counts.limit_evaluations)} <small><a href="#limits">Results</a></small></dd></div>
  </dl>

  <h2 id="corrections">Corrections to models.dev</h2>
  <p class="hint mb-3 max-w-3xl">Fields where providers.dev publishes a different value from models.dev. A correction is dropped as soon as models.dev agrees.</p>
  {groups.size === 0 && <p class="muted">None at the moment.</p>}
  {
    [...groups.values()].map(({ change, refs }) => (
      <div class="change !max-w-none">
        <p>
          <code>{change.path}</code>{" "}
          {change.op === "set" ? <>is <strong><code>{JSON.stringify(change.value)}</code></strong></> : change.op === "unknown" ? <>is published as <strong>unknown</strong></> : <>is <strong>removed</strong></>}
          {" "}on {exact(refs.length)} {refs.length === 1 ? "entry" : "entries"}. models.dev says: {change.had_upstream ? <code>{JSON.stringify(change.upstream)}</code> : <span class="muted">nothing</span>}.
        </p>
        <p class="muted mt-1">{change.reason}</p>
        <ul class="evidence">
          {change.evidence.map((item) => (
            <li>
              <span class:list={["badge", item.kind]}>{item.kind}</span> <a href={item.url} rel="noopener">{host(item)}</a> <span class="muted date">{item.date}</span>
              {item.note && <div class="hint">{item.note}</div>}
            </li>
          ))}
        </ul>
        <details>
          <summary class="hint">{exact(refs.length)} {refs.length === 1 ? "entry" : "entries"}</summary>
          <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1">{refs.map((ref) => <a href={entryHref(ref)}><code>{ref}</code></a>)}</p>
        </details>
      </div>
    ))
  }

  <h2 id="added">Added providers</h2>
  <p class="hint mb-3 max-w-3xl">Access methods that models.dev does not list. Only models with evidence on that access method are included.</p>
  <div class="scroll">
    <table class="entries">
      <thead><tr><th scope="col">Provider</th><th scope="col">Access</th><th scope="col" class="num">Entries</th></tr></thead>
      <tbody>
        {
          added.map((provider) => (
            <tr>
              <th scope="row"><a href={`/providers/${provider.id}/`}>{provider.name}</a><div class="id"><code>{provider.id}</code></div></th>
              <td>{provider.providers_dev.access_basis}<div class="hint">{provider.providers_dev.note}</div></td>
              <td class="num">{exact(provider.entry_count)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="cache">Cache evaluations</h2>
  <p class="hint mb-3 max-w-3xl">
    An evaluation caches a fresh prompt, sends it again at once, and then again at set ages. A cell is the share of those re-sends that were served from the cache, in percent; hover it for
    the counts. A result holds for the access method and client named, on that date; it is what was observed, not a guaranteed lifetime.
    <a href="/docs/methodology/#evaluations">How evaluations work</a>
  </p>
  <div class="scroll">
    <table class="entries">
      <thead><tr><th scope="col">Entry</th><th scope="col">Measured through</th><th scope="col" class="strip-col"><span>Served from the cache <span class="muted">% by age</span></span><Fragment set:html={STRIP_HEAD} /></th><th scope="col">Date</th><th scope="col">Evidence</th></tr></thead>
      <tbody>
        {
          runs.map((run) => (
            <tr>
              <th scope="row"><a href={`${entryHref(run.entry_ref)}#cache`}>{run.entry_name}</a><div class="id"><code>{run.entry_ref}</code></div></th>
              <td>{run.route_label}<div class="hint">{run.client_label}{settingsText(run.request_settings) && ` · ${settingsText(run.request_settings)}`}</div></td>
              <td set:html={evaluationStrip(run)} />
              <td>{isStale(run.date, now) ? <span class="stale">{run.date} · stale</span> : <span class="muted date">{run.date}</span>}</td>
              <td class="nowrap"><a href={run.source} rel="noopener">Raw result</a></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="limits">Measured limits</h2>
  <div class="scroll">
    <table class="entries">
      <thead><tr><th scope="col">Entry</th><th scope="col">Measured through</th><th scope="col">Result</th><th scope="col">Date</th><th scope="col">Evidence</th></tr></thead>
      <tbody>
        {
          limits.map((limit) => (
            <tr>
              <th scope="row"><a href={`${entryHref(limit.entry_ref)}#limits`}>{limit.entry_name}</a><div class="id"><code>{limit.entry_ref}</code></div></th>
              <td>{limit.route_label}<div class="hint">{limit.client_label}</div></td>
              <td>
                {[
                  limit.context !== undefined && `context ${exact(limit.context)}`,
                  limit.output !== undefined && `output ${exact(limit.output)}`,
                  limit.input_accepted !== undefined && `accepted an input of ${exact(limit.input_accepted)}`,
                  limit.input_refused !== undefined && `refused an input of ${exact(limit.input_refused)}`,
                  limit.output_accepted !== undefined && `accepted a requested output of ${exact(limit.output_accepted)}`,
                ].filter(Boolean).join("; ")}
                {limit.note && <div class="hint">{limit.note}</div>}
              </td>
              <td>{limit.date ? <span class="muted date">{limit.date}</span> : <span class="muted">Undated</span>}</td>
              <td class="nowrap"><a href={limit.source} rel="noopener">Raw result</a></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="issues">Open issues in this dataset</h2>
  {
    meta.issues.length === 0 && meta.exclusions.length === 0 ? (
      <p class="muted">None. Every correction and evaluation matched an entry, and nothing is excluded.</p>
    ) : (
      <ul class="prose">
        {meta.issues.map((issue) => <li><span class="badge plain">{issue.level}</span> <code>{issue.target}</code> {issue.message}</li>)}
        {meta.exclusions.map((item) => <li><span class="badge plain">excluded</span> <code>{item.target}</code> {item.reason}</li>)}
      </ul>
    )
  }
  <p class="hint mt-3 max-w-3xl">
    A correction whose entry disappears from models.dev is listed here instead of being dropped silently or turned into a stale entry. The same list is in
    <a href="/api/v1/meta"><code>/api/v1/meta</code></a>.
  </p>
</Base>
