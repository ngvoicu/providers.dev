---
import Base from "../../layouts/Base.astro";
import { duration, entryHref, exact, isStale, STALE_AFTER_DAYS } from "../../core/format.ts";
import { ext, providerExt, type Evidence, type MeasuredLimit, type Measurement, type Provenance } from "../../core/schema.ts";
import { catalog, index, meta, now, providerNames } from "../../lib/data.ts";

const runs: { ref: string; name: string; run: Measurement }[] = [];
const limits: { ref: string; name: string; limit: MeasuredLimit }[] = [];
const groups = new Map<string, { change: Provenance; refs: string[] }>();
for (const entry of index.entries) {
  if (entry.origin === "upstream") continue;
  const extension = ext(catalog[entry.provider]!.models[entry.model]!);
  for (const run of extension.cache?.observed ?? []) runs.push({ ref: entry.ref, name: entry.name, run });
  for (const limit of extension.limits?.measured ?? []) limits.push({ ref: entry.ref, name: entry.name, limit });
  for (const change of extension.provenance ?? []) {
    const key = JSON.stringify([entry.provider, change.path, change.op, change.value, change.reason]);
    const group = groups.get(key) ?? groups.set(key, { change, refs: [] }).get(key)!;
    group.refs.push(entry.ref);
  }
}
runs.sort((a, b) => b.run.date.localeCompare(a.run.date) || a.ref.localeCompare(b.ref));
const added = index.providers.filter((provider) => provider.origin === "added");
const staleRuns = runs.filter((item) => isStale(item.run.date, now)).length;
const through = (run: Measurement): string =>
  run.all_warm_through_s === null ? "no age with every check warm" : `every check warm through ${duration(run.all_warm_through_s)}`;
const host = (item: Evidence): string => new URL(item.url).hostname;
---

<Base title="Our data" description="Everything on providers.dev that does not come from models.dev: added providers, corrections and cache measurements, each with its source and date." wide>
  <h1>Our data</h1>
  <p class="lead mt-1">
    Everything here that does not come from models.dev, in one place: {exact(meta.counts.added_providers)} providers and {exact(meta.counts.added_models)} entries we add,{" "}
    {exact(meta.counts.overridden_models)} entries we correct, and {exact(runs.length)} cache measurements on {exact(meta.counts.measured_models)} entries. Each item names its source and
    date. Evidence older than {STALE_AFTER_DAYS} days is marked stale{staleRuns > 0 ? <> ({exact(staleRuns)} measurements today)</> : <> (none today)</>}.
  </p>

  <h2 id="corrections">Corrections to models.dev</h2>
  {groups.size === 0 && <p class="muted">None at the moment.</p>}
  {
    [...groups.values()].map(({ change, refs }) => (
      <div class="change !max-w-none">
        <p>
          <code>{change.path}</code>{" "}
          {change.op === "set" ? <>is <strong><code>{JSON.stringify(change.value)}</code></strong></> : change.op === "unknown" ? <>is published as <strong>unknown</strong></> : <>is <strong>removed</strong></>}
          {" "}on {exact(refs.length)} {refs.length === 1 ? "entry" : "entries"}. models.dev says: {change.had_upstream ? <code>{JSON.stringify(change.upstream)}</code> : <span class="muted">nothing</span>}.
        </p>
        <p class="mt-1">{change.reason}</p>
        <ul class="evidence">
          {change.evidence.map((item) => (
            <li>
              <span class:list={["badge", item.kind]}>{item.kind}</span> <a href={item.url} rel="noopener">{host(item)}</a> <span class="muted">{item.date}</span>
              {item.note && <div class="hint">{item.note}</div>}
            </li>
          ))}
        </ul>
        <details>
          <summary class="hint">{exact(refs.length)} {refs.length === 1 ? "entry" : "entries"}</summary>
          <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1">{refs.map((ref) => <a href={entryHref(ref)}><code>{ref}</code></a>)}</p>
        </details>
      </div>
    ))
  }

  <h2 id="added">Providers we add</h2>
  <div class="scroll">
    <table class="entries">
      <thead><tr><th scope="col">Provider</th><th scope="col">Why it is separate</th><th scope="col" class="num">Entries</th></tr></thead>
      <tbody>
        {
          added.map((provider) => (
            <tr>
              <th scope="row"><a href={`/providers/${provider.id}/`}>{provider.name}</a><div class="id"><code>{provider.id}</code></div></th>
              <td>{providerExt(catalog[provider.id]!).access_basis}<div class="hint">{providerExt(catalog[provider.id]!).note}</div></td>
              <td class="num">{exact(provider.models)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="cache">Cache measurements</h2>
  <p class="hint mb-2 max-w-3xl">
    Each run primes a fresh prompt and re-sends it once at fixed ages. The result holds for the route and client named, on that date; it is not a promised lifetime. Method and raw results:
    <a href={meta.measurements?.repository}>{meta.measurements?.repository.replace("https://", "")}</a>.
  </p>
  <div class="scroll">
    <table class="entries">
      <thead><tr><th scope="col">Entry</th><th scope="col">Measured through</th><th scope="col">Result</th><th scope="col">Date</th><th scope="col">Evidence</th></tr></thead>
      <tbody>
        {
          runs.map(({ ref, name, run }) => (
            <tr>
              <th scope="row"><a href={`${entryHref(ref)}#cache`}>{name}</a><div class="id"><code>{ref}</code></div></th>
              <td>{run.route_label}<div class="hint">client: {run.client}{run.options && ` · ${Object.entries(run.options).map(([k, v]) => `${k}=${v}`).join(", ")}`}</div></td>
              <td>{through(run)}{run.first_all_cold_s !== null && <span class="muted">; all cold at {duration(run.first_all_cold_s)}</span>}</td>
              <td>{isStale(run.date, now) ? <span class="stale">{run.date} · stale</span> : run.date}</td>
              <td><a href={run.source} rel="noopener">raw result</a></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="limits">Measured limits</h2>
  <div class="scroll">
    <table class="entries">
      <thead><tr><th scope="col">Entry</th><th scope="col">Measured through</th><th scope="col">Result</th><th scope="col">Date</th><th scope="col">Evidence</th></tr></thead>
      <tbody>
        {
          limits.map(({ ref, name, limit }) => (
            <tr>
              <th scope="row"><a href={`${entryHref(ref)}#limits`}>{name}</a><div class="id"><code>{ref}</code></div></th>
              <td>{limit.route_label}<div class="hint">client: {limit.client}</div></td>
              <td>
                {[
                  limit.context !== undefined && `context ${exact(limit.context)}`,
                  limit.output !== undefined && `output ${exact(limit.output)}`,
                  limit.input_accepted !== undefined && `accepted an input of ${exact(limit.input_accepted)}`,
                  limit.input_refused !== undefined && `refused an input of ${exact(limit.input_refused)}`,
                  limit.output_accepted !== undefined && `accepted a requested output of ${exact(limit.output_accepted)}`,
                ].filter(Boolean).join("; ")}
                {limit.note && <div class="hint">{limit.note}</div>}
              </td>
              <td>{limit.date ?? <span class="muted">undated</span>}</td>
              <td><a href={limit.source} rel="noopener">raw result</a></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="issues">Open issues in this build</h2>
  {
    meta.issues.length === 0 && meta.exclusions.length === 0 ? (
      <p class="muted">None. Every override and measurement found its entry, and nothing is excluded.</p>
    ) : (
      <ul class="prose">
        {meta.issues.map((issue) => <li><span class="badge plain">{issue.level}</span> <code>{issue.target}</code> {issue.message}</li>)}
        {meta.exclusions.map((item) => <li><span class="badge plain">excluded</span> <code>{item.target}</code> {item.reason}</li>)}
      </ul>
    )
  }
  <p class="hint mt-2">
    An override whose entry disappears upstream is listed here instead of being dropped or turned into a stale entry. The same list is in <a href="/api/v1/meta"><code>/api/v1/meta</code></a>.
    Provider names: {Object.keys(providerNames).length} in this dataset.
  </p>
</Base>
