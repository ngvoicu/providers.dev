---
import Base from "../../layouts/Base.astro";
import { exact, modelHref } from "../../core/format.ts";
import { entriesByCanonical } from "../../lib/data.ts";

const models = [...entriesByCanonical.entries()]
  .map(([id, entries]) => ({
    id,
    name: (entries.find((entry) => `${entry.provider}/${entry.model}` === id) ?? entries[0]!).name,
    count: entries.length,
    subscription: entries.filter((entry) => entry.access === "subscription").length,
    ours: entries.filter((entry) => entry.origin !== "upstream").length,
  }))
  .sort((a, b) => b.count - a.count || a.id.localeCompare(b.id));
---

<Base title="Models" description="Canonical models and every provider and access method that serves each of them.">
  <h1>Models</h1>
  <p class="lead mt-1">
    {exact(models.length)} canonical models. Each page lists every provider and access method for that model side by side, because the same model is often
    exposed with a different context window, output limit or cache behaviour depending on where you reach it.
  </p>
  <label class="field mt-4 max-w-sm">Filter <input id="filter" type="search" placeholder="name or id" autocomplete="off" spellcheck="false" /></label>
  <div class="scroll mt-3">
    <table class="entries">
      <thead>
        <tr><th scope="col">Model</th><th scope="col" class="num">Entries</th><th scope="col" class="num">By subscription</th><th scope="col" class="num">With our data</th></tr>
      </thead>
      <tbody id="list">
        {
          models.map((model) => (
            <tr data-text={`${model.id} ${model.name}`.toLowerCase()}>
              <th scope="row">
                <a href={modelHref(model.id)}>{model.name}</a>
                <div class="id"><code>{model.id}</code></div>
              </th>
              <td class="num">{exact(model.count)}</td>
              <td class="num">{model.subscription > 0 ? exact(model.subscription) : <span class="muted">–</span>}</td>
              <td class="num">{model.ours > 0 ? exact(model.ours) : <span class="muted">–</span>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div id="none" class="empty" hidden>No model matches.</div>
  </div>
</Base>

<script>
  const input = document.getElementById("filter") as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("#list tr")];
  const none = document.getElementById("none") as HTMLElement;
  input.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      const match = words.every((word) => (row.dataset.text ?? "").includes(word));
      row.hidden = !match;
      if (match) shown += 1;
    }
    none.hidden = shown > 0;
  });
</script>
