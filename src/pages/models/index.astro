---
// Canonical models. The rows are the answer of GET /api/v1/models.
import Base from "../../layouts/Base.astro";
import { exact, modelHref } from "../../core/format.ts";
import { models } from "../../lib/data.ts";
---

<Base title="Models" description="Canonical models and every provider and access method that serves each of them.">
  <h1>Models</h1>
  <p class="lead mt-3">
    {exact(models.length)} canonical models: a model as its lab names it. Each page lists every entry for that model side by side, because the same model is often
    exposed with a different context window, output limit or cache behaviour depending on where you reach it.
  </p>
  <label class="field mt-6 max-w-sm">Filter models <input id="filter" type="search" placeholder="Name or id" autocomplete="off" spellcheck="false" /></label>
  <div class="scroll mt-3">
    <table class="entries">
      <thead>
        <tr><th scope="col">Model</th><th scope="col" class="num">Entries</th><th scope="col" class="num">By subscription</th><th scope="col" class="num">With providers.dev evidence</th></tr>
      </thead>
      <tbody id="list">
        {
          models.map((model) => (
            <tr data-text={`${model.id} ${model.name}`.toLowerCase()}>
              <th scope="row">
                <a href={modelHref(model.id)}>{model.name}</a>
                <div class="id"><code>{model.id}</code></div>
              </th>
              <td class="num">{exact(model.entry_count)}</td>
              <td class="num">{model.subscription_entry_count > 0 ? exact(model.subscription_entry_count) : <span class="muted">–</span>}</td>
              <td class="num">{model.evidence_entry_count > 0 ? exact(model.evidence_entry_count) : <span class="muted">–</span>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div id="none" class="empty" hidden>No model matches.</div>
  </div>
</Base>

<script>
  const input = document.getElementById("filter") as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("#list tr")];
  const none = document.getElementById("none") as HTMLElement;
  input.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      const match = words.every((word) => (row.dataset.text ?? "").includes(word));
      row.hidden = !match;
      if (match) shown += 1;
    }
    none.hidden = shown > 0;
  });
</script>
