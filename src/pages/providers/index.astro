---
import Base from "../../layouts/Base.astro";
import { exact } from "../../core/format.ts";
import { index } from "../../lib/data.ts";

const providers = [...index.providers].sort((a, b) => a.name.localeCompare(b.name));
const accessLabel = { api: "API key", subscription: "Subscription", unknown: "Unclassified" } as const;
---

<Base title="Providers" description="Every provider in the catalog, how it is reached, and how many models it serves.">
  <h1>Providers</h1>
  <p class="lead mt-3">
    {exact(providers.length)} providers. Access says how a provider is reached: an API key billed by use, or a subscription login or plan. It is a classification only; plans and prices are
    not tracked here. A value marked <em>default</em> or <em>by name</em> has not been reviewed individually.
  </p>
  <label class="field mt-6 max-w-sm">Filter providers <input id="filter" type="search" placeholder="Name or id" autocomplete="off" spellcheck="false" /></label>
  <div class="scroll mt-3">
    <table class="entries">
      <thead>
        <tr><th scope="col">Provider</th><th scope="col">Access</th><th scope="col" class="num">Models</th><th scope="col" class="num">With providers.dev evidence</th><th scope="col">Source</th></tr>
      </thead>
      <tbody id="list">
        {
          providers.map((provider) => (
            <tr data-text={`${provider.id} ${provider.name}`.toLowerCase()}>
              <th scope="row">
                <a href={`/providers/${provider.id}/`}>{provider.name}</a>
                <div class="id"><code>{provider.id}</code></div>
              </th>
              <td>
                {accessLabel[provider.access]}
                {!provider.access_reviewed && <span class="hint"> · {provider.access === "api" ? "default" : "by name"}</span>}
              </td>
              <td class="num">{exact(provider.models)}</td>
              <td class="num">{provider.with_evidence > 0 ? <a href={`/?provider=${provider.id}&origin=modified,added`}>{exact(provider.with_evidence)}</a> : <span class="muted">–</span>}</td>
              <td><span class:list={["origin", provider.origin]}>{provider.origin === "added" ? "providers.dev" : "models.dev"}</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div id="none" class="empty" hidden>No provider matches.</div>
  </div>
</Base>

<script>
  const input = document.getElementById("filter") as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("#list tr")];
  const none = document.getElementById("none") as HTMLElement;
  input.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      const match = words.every((word) => (row.dataset.text ?? "").includes(word));
      row.hidden = !match;
      if (match) shown += 1;
    }
    none.hidden = shown > 0;
  });
</script>
