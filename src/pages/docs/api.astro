---
// The API documentation. The endpoint list, the parameter tables and the field tables are generated from the same
// definitions the API validates with and answers from (openapi.ts, query.ts, contract.ts): nothing here is a second copy.
import Doc from "../../layouts/Doc.astro";
import { ENDPOINTS, fieldRows, type FieldRow } from "../../core/openapi.ts";
import { DEFAULT_LIMIT, MAX_LIMIT, type ParamDoc } from "../../core/query.ts";
import { meta } from "../../lib/data.ts";

const paramValue = (param: ParamDoc): string =>
  param.values ? param.values.join(param.kind === "list" ? ", " : " | ") : param.kind === "integer" ? "whole number" : param.kind === "boolean" ? "true | false" : param.kind === "list" ? "comma-separated" : "text";
const parts: { id: string; title: string; note: string; rows: FieldRow[] }[] = [
  { id: "entry-summary", title: "EntrySummary", note: "An item of /api/v1/entries, and the summary of a single entry. The tables of this website show these fields and nothing else.", rows: fieldRows("EntrySummary") },
  { id: "cache-summary-row", title: "CacheSummaryRow", note: "An item of cache_results: one line of the cache summary.", rows: fieldRows("CacheSummaryRow") },
  { id: "cache-result", title: "CacheResult", note: "An item of results: what was seen at one age.", rows: fieldRows("CacheResult") },
  { id: "cache-retention", title: "CacheRetention", note: "providers_dev.cache.retention of an entry: what a request can do about the cache lifetime.", rows: fieldRows("CacheRetention") },
  { id: "cache-evaluation", title: "CacheEvaluation", note: "An item of providers_dev.cache.evaluations, and of /api/v1/evaluations with kind = cache.", rows: fieldRows("CacheEvaluation") },
  { id: "measured-limit", title: "MeasuredLimit", note: "An item of providers_dev.limits.measured, and of /api/v1/evaluations with kind = limit.", rows: fieldRows("MeasuredLimit") },
  { id: "entry-extension", title: "EntryExtension", note: "providers_dev of an entry.", rows: fieldRows("EntryExtension") },
  { id: "provider-summary", title: "ProviderSummary", note: "An item of /api/v1/providers.", rows: fieldRows("ProviderSummary") },
  { id: "provider-extension", title: "ProviderExtension", note: "providers_dev of a provider.", rows: fieldRows("ProviderExtension") },
  { id: "canonical-model", title: "CanonicalModel", note: "An item of /api/v1/models. A single model also has entries, a list of EntrySummary.", rows: fieldRows("CanonicalModel") },
  { id: "meta", title: "Meta", note: "The answer of /api/v1/meta.", rows: fieldRows("Meta") },
];

const ts = `type Page<T> = { total: number; limit: number; offset: number; next_offset: number | null; data: T[] };
type CacheResult = { kind: "control" | "timed"; age_s: number; hits: number; checks: number; hit_rate_pct: number };
type CacheSummaryRow = { retention_profile: "short" | "long"; parameter: string | null; value: string | null; evaluations: number; results: CacheResult[] | null };
type Entry = {
  ref: string; provider: string; model: string; name: string;
  access: "api" | "subscription" | "unknown";
  origin: "upstream" | "modified" | "added";
  context?: number; max_output?: number;          // tokens; absent = unknown
  cache: "yes" | "no" | "unknown"; cache_ttl_s: number[];
  cache_results: CacheSummaryRow[] | null;        // null = not evaluated
  evaluation_count: number; verified?: string;
};

const base = "https://providers.dev/api/v1";

// Every subscription entry with at least a 400k context window, largest first.
async function* entries(params: Record<string, string>): AsyncGenerator<Entry> {
  let offset: number | null = 0;
  while (offset !== null) {
    const query = new URLSearchParams({ ...params, limit: "${MAX_LIMIT}", offset: String(offset) });
    const response = await fetch(\`\${base}/entries?\${query}\`);
    if (!response.ok) throw new Error((await response.json()).error.message);
    const page = (await response.json()) as Page<Entry>;
    yield* page.data;
    offset = page.next_offset;
  }
}

for await (const entry of entries({ access: "subscription", min_context: "400000", sort: "context", order: "desc" })) {
  console.log(entry.ref, entry.context, entry.cache);
}

// How long does the cache hold with nothing asked for? The share of re-sends served from the cache, age by age.
for await (const entry of entries({ evaluated: "true" })) {
  const short = entry.cache_results?.find((row) => row.retention_profile === "short");
  for (const result of short?.results ?? []) {
    console.log(entry.ref, result.kind === "control" ? "at once" : \`\${result.age_s} s\`, \`\${result.hit_rate_pct}% (\${result.hits}/\${result.checks})\`);
  }
}

// One entry in full: the provider is the first path segment, the model id is the rest.
const { data } = await (await fetch(\`\${base}/entries/openrouter/anthropic/claude-opus-5.5\`)).json();
console.log(data.entry.limit, data.entry.providers_dev.cache.retention, data.entry.providers_dev.cache.evaluations);`;

const curl = `# Search and filter entries
curl 'https://providers.dev/api/v1/entries?q=opus&cache=yes&min_context=500000&sort=context&order=desc'

# One entry in full
curl https://providers.dev/api/v1/entries/openrouter/anthropic/claude-opus-5.5

# One provider with the summaries of its entries
curl https://providers.dev/api/v1/providers/anthropic

# One canonical model with every entry that serves it
curl https://providers.dev/api/v1/models/anthropic/claude-opus-5-5

# The cache evaluations that asked for a longer lifetime
curl 'https://providers.dev/api/v1/evaluations?kind=cache&retention_profile=long'

# Download only when the data changed
curl -H 'If-None-Match: "${meta.dataset_version}"' -i https://providers.dev/api/v1/catalog   # 304 Not Modified

# The models.dev-shaped export
curl -sI https://providers.dev/api.json | grep -i x-dataset`;
---

<Doc
  title="API"
  description="The read-only JSON API of providers.dev: endpoints, filters, the providers_dev extension and examples."
  lead="A read-only JSON API over the same published snapshot this website is built from. No key is needed, CORS is open, and requests are GET only. Requests never reach models.dev: every response is served from the last published snapshot."
  toc={[
    { id: "resources", label: "Resources" },
    { id: "endpoints", label: "Endpoints" },
    { id: "lookup", label: "Naming one entry" },
    { id: "parameters", label: "Parameters" },
    { id: "paging", label: "Paging and order" },
    { id: "unknown", label: "Unknown values" },
    { id: "cache", label: "Cache evaluations" },
    { id: "fields", label: "Fields" },
    { id: "caching", label: "Versions and caching" },
    { id: "errors", label: "Errors" },
    { id: "compat", label: "Compatibility with models.dev" },
    { id: "examples", label: "Examples" },
  ]}
>
  <div class="prose">
    <h2 id="resources">Resources</h2>
    <p>The API and this website use the same four names for the same four things.</p>
  </div>
  <div class="scroll">
    <table class="facts">
      <thead><tr><th scope="col">Resource</th><th scope="col">Meaning</th></tr></thead>
      <tbody>
        <tr><th scope="row">Providers</th><td>Who serves models, and how they are reached: an API key, or a subscription login or plan.</td></tr>
        <tr><th scope="row">Entries</th><td>A model at a provider and access method. Limits, prices and caching belong to an entry, because the same model differs from one provider to the next.</td></tr>
        <tr><th scope="row">Models</th><td>Canonical models: a model as its lab names it. Several entries can serve the same one.</td></tr>
        <tr><th scope="row">Evaluations</th><td>What providers.dev measured on an entry: cache behaviour and limits, each with its client, request settings, date and raw result.</td></tr>
      </tbody>
    </table>
  </div>
  <div class="prose">
    <p>
      Every collection answers <code>&#123; meta, total, limit, offset, next_offset, data &#125;</code> and pages with <code>limit</code> and <code>offset</code>. Every single object answers
      <code>&#123; meta, data &#125;</code>. The pages of this website are drawn from these same answers: a page formats a value, it does not work one out.
    </p>
    <h2 id="endpoints">Endpoints</h2>
  </div>
  <div class="scroll">
    <table class="facts">
      <thead><tr><th scope="col">Request</th><th scope="col">Returns</th></tr></thead>
      <tbody>
        {
          ENDPOINTS.map((endpoint) => (
            <tr>
              <th scope="row">{endpoint.path.includes("{") ? <code>GET {endpoint.path}</code> : <a href={endpoint.path}><code>GET {endpoint.path}</code></a>}</th>
              <td>{endpoint.summary}.{endpoint.description && <div class="hint">{endpoint.description}</div>}<div class="hint">Returns: {endpoint.returns}.</div></td>
            </tr>
          ))
        }
        <tr><th scope="row"><a href="/api.json"><code>GET /api.json</code></a></th><td>The merged catalog keyed by provider id, in the models.dev v2 structure, with no envelope.</td></tr>
      </tbody>
    </table>
  </div>

  <div class="prose">
    <h2 id="lookup">Naming one entry</h2>
    <p>
      An entry is a model at a provider. Its <code>ref</code> is <code>provider/model</code>. Provider ids never contain a slash, so the provider is everything before the first slash and the
      model id is the rest, slashes included: <code>openrouter/anthropic/claude-opus-5.5</code> is model <code>anthropic/claude-opus-5.5</code> at provider <code>openrouter</code>.
    </p>
    <p>
      The path of an entry is its <code>ref</code>: the provider first, then the model id, slashes and all. Encode each part of the path where it holds a character a URL reserves
      (<code>:</code>, <code>@</code>, <code>?</code>, <code>#</code>). The page of an entry on this website has the same path without <code>/api/v1</code>.
    </p>
    <pre>/api/v1/entries/openrouter/anthropic/claude-opus-5.5
/entries/openrouter/anthropic/claude-opus-5.5</pre>

    <h2 id="parameters">Parameters</h2>
    <p>
      Filters combine with <em>and</em>. A parameter that is not listed for the endpoint, a value that is not allowed, or the same parameter given twice is answered with <code>400</code> and
      a list of what is wrong. The catalog page of this site uses the parameters of <code>/api/v1/entries</code> in its own address, so any view there can be copied as an API request.
    </p>
  </div>
  {
    ENDPOINTS.filter((endpoint) => endpoint.params.length > 0).map((endpoint) => (
      <>
        <div class="prose"><h3><code>{endpoint.path}</code></h3></div>
        <div class="scroll">
          <table class="facts">
            <thead><tr><th scope="col">Parameter</th><th scope="col">Value</th><th scope="col">Meaning</th></tr></thead>
            <tbody>
              {endpoint.params.map((param) => <tr><th scope="row"><code>{param.name}</code></th><td>{paramValue(param)}</td><td>{param.description}</td></tr>)}
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <div class="prose">
    <h2 id="paging">Paging and order</h2>
    <p>
      Every list pages the same way. <code>limit</code> is 1 to {MAX_LIMIT} (default {DEFAULT_LIMIT}); <code>offset</code> skips items. The answer holds <code>total</code> and
      <code>next_offset</code>, which is <code>null</code> on the last page. The order of entries is fixed: the sort key, then provider id, then model id, so paging never repeats or skips an
      entry within one dataset version. Entries with no value for the sort key come last in both directions.
    </p>

    <h2 id="unknown">Unknown, zero and unsupported</h2>
    <ul>
      <li>A limit that is <strong>absent</strong> is unknown. It is never written as 0, and it never matches <code>min_context</code> or <code>min_output</code>.</li>
      <li><code>cache: "no"</code> means the source says the entry does not cache. <code>cache: "unknown"</code> means the source says nothing.</li>
      <li><code>max_output</code> is a maximum. A provider's default output setting is a different thing and is not published as this field.</li>
      <li>A price that is <strong>absent</strong> is unknown, not free. A price of <code>0</code> is what the source lists: free of charge, or paid for another way.</li>
      <li>An entry with no <code>release_date</code> never matches <code>max_age_months</code>.</li>
      <li>A cache line that was not evaluated has <code>results: null</code>, and an entry with no evaluation has <code>cache_results: null</code>. Not evaluated is never 0 %.</li>
      <li>The pages use four words for a value that is not there. <strong>Unknown</strong>: no source gives it. <strong>Unsupported</strong>: a source says the entry cannot do it. <strong>Not evaluated</strong>: providers.dev has not measured it. <strong>Not applicable</strong>: the field has no meaning for this entry.</li>
    </ul>

    <h2 id="cache">Cache evaluations</h2>
    <p>
      An evaluation caches a fresh prompt, sends it again at once (the control), and then again at set ages. Everything this website shows about them is in the API, as counts and as a
      percentage. The website formats the numbers; it does not add them up.
    </p>
    <ul>
      <li>
        <strong>The summary.</strong> <code>cache_results</code> of an entry summary, and the same object as <code>providers_dev.cache.results</code> of the full entry. One line per retention
        setting: <code>short</code> (no lifetime asked for, or the shortest documented one) before <code>long</code> (a longer lifetime asked for), with the request field and the value that
        was sent. An evaluated entry always has a short line and at least one long line.
      </li>
      <li>
        <strong>Results.</strong> Each line has <code>results</code>: one item per age that was checked, the control first (<code>kind: "control"</code>, <code>age_s: 0</code>). Each item
        has <code>hits</code>, <code>checks</code> and <code>hit_rate_pct</code>. Ages are exact seconds: a check at 450 (7.5 minutes) is never folded into 600. An age that is not in the
        list was not checked.
      </li>
      <li>
        <strong>The columns.</strong> <code>/api/v1/meta</code> has <code>cache_ages_s</code>: the ages every summary table on this website has a column for, after the control. They are the
        ages every evaluation follows since 14 November 2026. Results at other ages are in the data like any other, and the entry's page lists them in words.
      </li>
      <li>
        <strong>The evaluations under it.</strong> <code>providers_dev.cache.evaluations</code> of the full entry, and <code>/api/v1/evaluations</code> for all of them: the client, the date,
        the request settings, the same kind of results, and the raw result as evidence. A line of the summary names its evaluations in <code>evaluation_ids</code>.
      </li>
      <li>
        <strong>Retention.</strong> <code>providers_dev.cache.retention</code> says what a request can ask for on the entry: whether a lifetime is accepted, the request field, the accepted
        values, and which value gives which profile, with evidence. Every entry has every field; where no source says, <code>support</code> is <code>unknown</code>.
      </li>
    </ul>
    <pre>{`"cache_results": [
  { "retention_profile": "short", "parameter": null, "value": null, "evaluations": 1, "evaluation_ids": ["…"], "last_date": "2026-11-13",
    "results": [
      { "kind": "control", "age_s": 0,   "hits": 3, "checks": 3, "hit_rate_pct": 100 },
      { "kind": "timed",   "age_s": 150, "hits": 3, "checks": 3, "hit_rate_pct": 100 },
      { "kind": "timed",   "age_s": 300, "hits": 2, "checks": 3, "hit_rate_pct": 66.67 },
      { "kind": "timed",   "age_s": 450, "hits": 0, "checks": 3, "hit_rate_pct": 0 }
    ] },
  { "retention_profile": "long", "parameter": null, "value": null, "evaluations": 0, "evaluation_ids": [], "last_date": null, "results": null }
]`}</pre>
    <p class="hint">Illustrative values. The second line was not evaluated: its results are null.</p>

    <h2 id="fields">Fields</h2>
    <p>
      These tables are generated from the definitions the API is checked against; the <a href="/api/v1/openapi.json">OpenAPI document</a> has the same definitions in full. A field marked
      optional is left out when there is nothing to say. An entry in full keeps the models.dev fields of the model with their upstream meaning, and everything providers.dev adds is under
      one key, <code>providers_dev</code>, so it cannot be mistaken for upstream data.
    </p>
  </div>
  {
    parts.map((part) => (
      <>
        <div class="prose"><h3 id={part.id}><code>{part.title}</code></h3><p class="hint">{part.note}</p></div>
        <div class="scroll">
          <table class="facts">
            <thead><tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Meaning</th></tr></thead>
            <tbody>
              {part.rows.map((row) => <tr><th scope="row"><code>{row.name}</code>{!row.required && <div class="hint">optional</div>}</th><td><code>{row.type}</code></td><td>{row.description}</td></tr>)}
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <div class="prose">

    <h2 id="caching">Versions, freshness and conditional requests</h2>
    <p>
      Every answer carries <code>X-Dataset-Version</code> (a hash of the published data; it changes only when the data does), <code>X-Dataset-Generated-At</code> and
      <code>X-Upstream-Fetched-At</code>. The <code>ETag</code> is the dataset version. Send it back as <code>If-None-Match</code> and you get <code>304</code> with no body until the data
      changes. An answer filtered with <code>max_age_months</code> also changes with the day, so its <code>ETag</code> has the UTC date after the version. Answers may be cached for five minutes. Enveloped answers repeat the three values under <code>meta</code>; <code>/api.json</code> has no envelope, so there they are in the headers
      only.
    </p>
    <p>
      There are two version numbers and they are independent. <strong><code>v1</code></strong> in the path is the version of this API: its endpoints, parameters and envelope.
      <strong>{meta.upstream_schema}</strong> is the schema of the model fields, which models.dev still calls experimental and may change; <code>/api/v1/meta</code> reports it as
      <code>upstream_schema</code>.
    </p>

    <h2 id="errors">Errors</h2>
    <p>Every error has the same shape, with the matching HTTP status (<code>400</code>, <code>404</code>, <code>405</code>, <code>503</code>):</p>
    <pre>{`{ "error": { "code": "invalid_parameters", "message": "One or more query parameters are not valid.",
             "details": [ { "param": "min_context", "message": "Must be a whole number, 0 or more." } ] } }`}</pre>

    <h2 id="compat">How compatible <code>/api.json</code> is with models.dev</h2>
    <ul>
      <li>The root is an object keyed by provider id; each provider has <code>models</code> keyed by model id. Provider ids, model ids, <code>canonical_id</code> and field meanings are upstream's.</li>
      <li>Every provider and model has one extra key, <code>providers_dev</code>. A strict v2 parser must allow or drop it.</li>
      <li>Entries with <code>origin: "added"</code> hold only values with evidence. They can lack fields that models.dev requires (<code>modalities</code>, <code>capabilities</code>, <code>limit</code>, <code>cost</code>, <code>api</code>). Skip them, or treat missing as unknown.</li>
      <li>An added subscription entry can have a <code>cost</code> that is not its own: the API list price of the same model. It is marked by <code>cost</code> in <code>providers_dev.inherited.fields</code>.</li>
      <li>Fields listed in <code>provenance</code> differ from upstream on purpose.</li>
    </ul>
    <p>So it is a superset in the same shape, not a byte-compatible mirror.</p>

    <h2 id="examples">Examples</h2>
    <h3>curl</h3>
    <pre>{curl}</pre>
    <h3>TypeScript</h3>
    <pre>{ts}</pre>
  </div>
</Doc>
