---
import Base from "../layouts/Base.astro";
import { DEFAULT_LIMIT, parseQuery, runQuery, SITE_DEFAULT } from "../core/query.ts";
import { rowHtml, tableHead } from "../core/render.ts";
import { exact } from "../core/format.ts";
import { imported, index, meta, now, providerNames } from "../lib/data.ts";

// The first page is built ahead of time, so the table is there before any script runs.
// On the site, entries with providers.dev evidence come first, newest first; the API's default order is by provider.
const parsed = parseQuery(new URLSearchParams(SITE_DEFAULT), false);
const first = parsed.ok ? runQuery(index.entries, parsed.query) : { data: [], total: 0 };
const types = [...new Set(index.entries.map((entry) => entry.type).filter(Boolean))].sort() as string[];
const withEvidence = index.entries.filter((entry) => entry.origin !== "upstream").length;
const subscriptions = index.providers.filter((provider) => provider.access === "subscription").length;
---

<Base title="providers.dev">
  <header class="home-head">
    <h1>AI models as each provider exposes them</h1>
    <p class="lead">
      Context window, maximum output, price and prompt caching for {exact(meta.counts.entries)} entries: every model at every provider and access method, API keys and subscriptions alike.
      Built on <a href="https://models.dev">models.dev</a>, with <a href="/?origin=modified,added">{exact(withEvidence)} entries</a> corrected or evaluated by providers.dev.
    </p>
    <p class="facts-line muted">
      <span>{exact(meta.counts.providers)} providers, <a href="/?access=subscription">{exact(subscriptions)} by subscription</a></span>
      <span><a href="/models/">{exact(meta.counts.models)} models</a></span>
      <span><a href="/evidence/#cache">{exact(meta.counts.cache_evaluations)} cache evaluations</a></span>
      <span>Updated {meta.generated_at.slice(0, 10)}</span>
      <span><a href="/docs/api/">API</a> · <a href="/docs/methodology/">How values are sourced</a></span>
    </p>
  </header>

  <form id="filters" class="mt-5" role="search" aria-label="Filter entries">
    <label class="search block">
      <span class="sr-only">Search</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input type="search" name="q" placeholder="Search models, providers and families" autocomplete="off" spellcheck="false" />
      <kbd class="hidden sm:block">/</kbd>
    </label>
    <details id="more-filters" class="mt-3">
      <summary class="button sm:hidden">Filters</summary>
      <div class="panel mt-3 grid grid-cols-2 gap-3 sm:mt-0 sm:grid-cols-4 lg:grid-cols-8">
        <label class="field">Provider <input name="provider" list="provider-ids" placeholder="Any" autocomplete="off" spellcheck="false" /></label>
        <label class="field">Access
          <select name="access"><option value="">Any</option><option value="api">API key</option><option value="subscription">Subscription</option><option value="unknown">Unclassified</option></select>
        </label>
        <label class="field">Type
          <select name="type"><option value="">Any</option>{types.map((type) => <option value={type}>{type}</option>)}</select>
        </label>
        <label class="field">Cache, documented
          <select name="cache"><option value="">Any</option><option value="yes">Supported</option><option value="no">Not supported</option><option value="unknown">Unknown</option></select>
        </label>
        <label class="field">Cache mode
          <select name="cache_mode"><option value="">Any</option><option value="implicit">Automatic</option><option value="explicit">Manual</option></select>
        </label>
        <label class="field">Source
          <select name="origin"><option value="">Any</option><option value="modified,added">With providers.dev evidence</option><option value="added">providers.dev only</option><option value="upstream">models.dev only</option></select>
        </label>
        <label class="field">Cache evaluated
          <select name="evaluated"><option value="">Any</option><option value="true">Yes</option><option value="false">No</option></select>
        </label>
        <div class="field justify-end"><button type="reset" class="button">Clear filters</button></div>
        <label class="field col-span-2">Minimum context window (tokens)
          <input name="min_context" inputmode="numeric" placeholder="200000" autocomplete="off" aria-describedby="hint-context" />
          <span id="hint-context" class="hint">The window this provider exposes for the model. Entries with an unknown window are excluded.</span>
        </label>
        <label class="field col-span-2">Minimum maximum output (tokens)
          <input name="min_output" inputmode="numeric" placeholder="64000" autocomplete="off" aria-describedby="hint-output" />
          <span id="hint-output" class="hint">The largest single response, not a default. Entries with an unknown maximum are excluded.</span>
        </label>
        <label class="field col-span-2">Released
          <select name="max_age_months" aria-describedby="hint-released">
            <option value="">Any time</option>
            <option value="1">Last month</option>
            <option value="3">Last 3 months</option>
            <option value="6">Last 6 months</option>
            <option value="12">Last 12 months</option>
            <option value="24">Last 2 years</option>
          </select>
          <span id="hint-released" class="hint">Hides older models. Entries with an unknown release date are excluded.</span>
        </label>
      </div>
    </details>
    <script is:inline>
      // Filters are always open on wide screens, and on small ones when the address already carries a filter.
      (function () {
        var more = document.getElementById("more-filters");
        var filtered = /[?&](provider|access|type|cache|cache_mode|origin|evaluated|min_context|min_output|max_age_months)=/.test(location.search);
        if (matchMedia("(min-width: 640px)").matches || filtered) more.open = true;
      })();
    </script>
    <datalist id="provider-ids">{index.providers.map((provider) => <option value={provider.id}>{provider.name}</option>)}</datalist>
  </form>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[0.85rem]">
    <p id="count" class="font-medium" aria-live="polite">{exact(first.total)} entries</p>
    <p class="muted flex min-w-0 items-center gap-2">
      <span class="hidden sm:inline">This view as JSON</span>
      <a id="api-link" class="truncate" href={`/api/v1/entries?${SITE_DEFAULT}`}><code>/api/v1/entries?{SITE_DEFAULT}</code></a>
      <button type="button" id="api-copy" class="copy" data-copy={`/api/v1/entries?${SITE_DEFAULT}`} aria-label="Copy API URL">Copy</button>
    </p>
  </div>

  <div class="scroll mt-3">
    <table class="entries" id="entries" data-now={now.toISOString()}>
      <caption class="sr-only">Provider-model entries</caption>
      <thead id="head" set:html={tableHead({ sortable: true, sort: "verified", order: "desc" })} />
      <tbody id="rows" set:html={first.data.map((entry) => rowHtml(entry, { now, imported, providerNames })).join("")} />
    </table>
    <div id="empty" class="empty" hidden>
      <p class="font-medium text-fg">No entries match these filters</p>
      <p class="mt-1">Entries with unknown limits never match a minimum.</p>
      <p><button type="button" class="button mt-4" id="empty-reset">Clear filters</button></p>
    </div>
    <div id="failed" class="empty" hidden>
      <p class="font-medium text-fg">The catalog index could not be loaded</p>
      <p class="mt-1">Filtering is unavailable until it loads.</p>
      <p><button type="button" class="button mt-4" id="retry">Try again</button></p>
    </div>
  </div>

  <nav class="mt-4 flex items-center justify-between gap-3 text-[0.85rem]" aria-label="Pages">
    <button type="button" class="button" id="prev" disabled>Previous</button>
    <span id="page" class="muted">Page 1 of {Math.max(1, Math.ceil(first.total / DEFAULT_LIMIT))}</span>
    <button type="button" class="button" id="next" disabled={first.total <= DEFAULT_LIMIT}>Next</button>
  </nav>
  <noscript><p class="note mt-3">Filtering and paging need JavaScript. The <a href="/providers/">provider pages</a> and the <a href="/docs/api/">API</a> work without it.</p></noscript>
</Base>

<script>
  import "../client/explorer.ts";
</script>
