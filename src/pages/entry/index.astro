---
// The page around an entry. The Worker fills the marks for each request to /entries/{provider}/{model}
// (src/core/pages.ts), so every entry has its own address, title and description. Nobody is served this file as it is.
import Base from "../../layouts/Base.astro";
import { MARK } from "../../core/pages.ts";
---

<Base title={MARK.title} description={MARK.description} canonical={MARK.canonical}>
  <div id="entry" set:html={MARK.html} />
</Base>
