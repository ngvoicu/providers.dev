---
import Base from "../../layouts/Base.astro";
import { now } from "../../lib/data.ts";
---

<Base title="Entry" description="Limits, prompt caching and sources for one provider-model entry.">
  <div id="entry" data-now={now.toISOString()} aria-live="polite">
    <p class="muted">Loading the entry…</p>
  </div>
  <noscript><p class="note">This view needs JavaScript. The same data is at <code>/api/v1/entry?ref=provider/model</code>.</p></noscript>
</Base>

<script>
  import "../../client/entry.ts";
</script>
