---
// provimux.providers.dev/ (served at the subdomain's root; see src/core/provimux-site.ts). Every statement here is
// taken from Provimux's README (.github/README.md), pi-provimux's README or the provimux-ui release notes; the pools
// section also from the console's own words (provimux-ui's Models page) and the routing it describes; Savings from the
// README and the console's Savings page; pi-cache-keeper from its README and its site (src/pages/pi-cache-keeper).
import Provimux from "../../layouts/Provimux.astro";

const github = "https://github.com/ngvoicu/provimux";
const readme = `${github}#readme`;
const cliproxyapi = "https://github.com/router-for-me/CLIProxyAPI";
const install = "brew install ngvoicu/tap/provimux";

/** One row of what Provimux adds: what CLIProxyAPI does, and what Provimux does instead. HTML. */
interface Row { topic: string; cpa: string; pmx: string }
const groups: { title: string; promise: string; rows: Row[] }[] = [
  {
    title: "Cache",
    promise: "You pay for a prompt once and read it after that.",
    rows: [
      {
        topic: "OpenRouter",
        cpa: "A Claude-format client's cache markers are lost in translation, and a client that sends none gets none, so every such request pays for the whole prompt. Every model gets the same generic limits and the levels low, medium and high.",
        pmx: "Cache markers added where the client sent none, a 1-hour lifetime kept through translation, one upstream per conversation (<code>X-Session-Id</code>) so the cache keeps being read, and each model's real context window, output limit and reasoning levels. Any <code>openai-compatibility</code> entry on openrouter.ai gets it.",
      },
      {
        topic: "The prompt cache on OpenAI API keys",
        cpa: "<code>prompt_cache_options</code> is removed for every Codex credential, API keys included.",
        pmx: "A client's <code>prompt_cache_options.ttl</code> (for example <code>\"12h\"</code>) is forwarded on an OpenAI API key. Subscription logins are unchanged.",
      },
      {
        topic: "A Codex WebSocket replay",
        cpa: "A client that sends its whole conversation again has it merged with the previous turn: the model sees the conversation twice, and the request is billed at about twice the input.",
        pmx: "The conversation is answered as it was sent, not merged.",
      },
    ],
  },
  {
    title: "Clarity",
    promise: "You see which account has which models, which one answered, and why a route is paused.",
    rows: [
      {
        topic: "Which account answered",
        cpa: "A client behind the proxy sees one list of models and cannot tell which account it is using.",
        pmx: "The model list names the accounts behind each model, highest priority first (<code>/v1/models?include=accounts</code>), and every response names the one that answered (<code>X-CPA-AUTH-KIND</code>, <code>X-CPA-AUTH-PROVIDER</code>, <code>X-CPA-AUTH-HOST</code>).",
      },
      {
        topic: "Each login's own model list",
        cpa: "Claude, Codex, Meta and Devin logins and Gemini API keys offer the shared catalog, which is edited by hand: it can list a model a day late, keep a retired model that then answers 404, or list a model your plan is refused.",
        pmx: "Each of them offers what its own account lists: retired models disappear, and new ones appear the day the provider lists them. On by default (<code>models.live-lists</code>).",
      },
      {
        topic: "Limits of the models you configure",
        cpa: "An alias of <code>claude-opus-5-5</code> on a Claude API key reports a 500,000 context window and no output limit (CLIProxyAPI 8.0.77, Codex-format model list).",
        pmx: "The same alias reports 1,000,000 and 128,000: the limits of the catalog's model it points to.",
      },
      {
        topic: "Devin",
        cpa: "Every model is listed and enforced at 64,000 output tokens, and a quota that runs out pauses the whole login.",
        pmx: "Each model's own output limit (for example <code>kimi-k3</code> 131,072), with <code>--local-model</code> or a list you generate; and, when you switch it on, a quota pause on the refused model only.",
      },
      {
        topic: "The console",
        cpa: "The CLI Proxy API Management Center.",
        pmx: "provimux-ui: the same console in the providers.dev look, with Provimux's own pages Accounts, Models and Savings. Provimux downloads it and installs it only when it matches the release's checksums.",
      },
    ],
  },
];

/** The console screenshots: made with example data (accounts at example.com, made-up keys). */
const shot = (page: string, alt: string) => ({ page, alt });
const accounts = shot("accounts", "The console's Accounts page. Chips read 10 accounts, 7 working, 1 signed out, 1 cooling down, 1 off. A Claude card lists a subscription, alex@example.com, Working, priority 10, and an API key at api.anthropic.com, Working, priority 0. A ChatGPT · OpenAI card lists a subscription that is signed out, with a Sign in again button; a second subscription, team@example.com, Working, 1 model cooling down; and an API key at api.openai.com. A Gemini API key is off.");
const models = shot("models", "The console's Models page. Chips read 13 names, 2 of yours, 7 served by more than one account, 3 cooling down. Under Your names: opus with 4 accounts (a Claude subscription, cooling down, 46 min left (quota), priority 10; a Devin subscription, priority 5; a Claude API key at api.anthropic.com and an OpenRouter API key at openrouter.ai, both priority 0), then qwen-coder, served by an OpenRouter API key. Under Used in the last 30 days: claude-opus-5-5 with 2 accounts and 1508 requests, its subscription cooling down; gpt-6.1-terra with 3 accounts and 767 requests, one of them a subscription cooling down, 18 min left (quota); claude-sonnet-5-5 with 2 accounts.");

/**
 * A part of a console page, cropped: a wide crop from `from` pixels of the window up, and the console's own phone
 * layout below that. One picture per theme. Request counts in the pictures are by upstream model, as the gateway
 * records them, so a name of your own shows its accounts and no count.
 */
interface Crop { name: string; alt: string; from: number; wide: { width: number; height: number }; narrow: { width: number; height: number } }
const pool: Crop = {
  name: "pool",
  alt: "A name on the console's Models page: opus, Your name, 4 accounts. 1: a Claude subscription, alex@example.com, sends claude-opus-5-5, cooling down, 46 min left (quota), priority 10. 2: a Devin subscription, alex@example.com, sends devin/claude-opus-5-5, priority 5. 3, shared: a Claude API key at api.anthropic.com sends claude-opus-5-5, priority 0, and an OpenRouter API key at openrouter.ai sends anthropic/claude-opus-5.5, priority 0.",
  from: 640,
  wide: { width: 744, height: 318 },
  narrow: { width: 424, height: 458 },
};
const savings: Crop = {
  name: "savings",
  alt: "The console's Savings page for Nov 1 to Nov 25, 2026, in days of the server's zone, priced with OpenRouter's public list at base rates (long-context tiers not applied). Worth of prompt caching, an estimate: $972.71, of which $83.57 on API keys, money that would have been paid, and $889.14 on subscriptions, which saves quota, not dollars. Copy the line: Prompt caching through Provimux was worth $972 this month at base API list prices.",
  from: 900,
  wide: { width: 1162, height: 733 },
  narrow: { width: 424, height: 620 },
};
const cropPicture = (crop: Crop, scheme: "light" | "dark") =>
  `<picture class="shot-${scheme}">` +
  `<source media="(min-width: ${crop.from}px)" srcset="/media/console-${crop.name}-wide-${scheme}.webp 1x, /media/console-${crop.name}-wide-${scheme}-2x.webp 2x" width="${crop.wide.width}" height="${crop.wide.height}">` +
  `<img src="/media/console-${crop.name}-narrow-${scheme}.webp" srcset="/media/console-${crop.name}-narrow-${scheme}-2x.webp 2x" width="${crop.narrow.width}" height="${crop.narrow.height}" alt="${crop.alt}" decoding="async" loading="lazy">` +
  `</picture>`;
const cropPictures = (crop: Crop) => cropPicture(crop, "light") + cropPicture(crop, "dark");

/**
 * pi's /model list with pi-provimux 105.0.7. Each line as pi 1.6.0's selector draws it (model-selector.js: the cursor
 * "→ ", the current model's "✓ ", the id, the name in brackets, the provider): the name is the model's display name in
 * Provimux's model list, " · ", and where it comes from, as pi-provimux's sourceLabel (extensions/sources.ts) says it
 * for these accounts: the ones at the highest priority, joined by "or", then "fallback" and the others, highest first.
 * The pool's display name is the one its rows set (README: set display-name on each alias row of a shared name).
 */
const piRows: { id: string; name: string; source: string; current?: boolean }[] = [
  { id: "opus", name: "Claude Opus 5.5", source: "Anthropic sub, fallback Devin sub, Anthropic api, OpenRouter api", current: true },
  { id: "claude-opus-5-5", name: "Claude Opus 5.5", source: "Anthropic sub, fallback api" },
  { id: "claude-sonnet-5-5", name: "Claude Sonnet 5.5", source: "Anthropic sub or api" },
  { id: "gpt-6.1-terra", name: "GPT 6.1 Terra", source: "OpenAI sub, fallback api" },
  { id: "devin/kimi-k3", name: "Kimi K3 (Devin)", source: "Devin sub" },
  { id: "anthropic/claude-opus-5.5", name: "anthropic/claude-opus-5.5", source: "OpenRouter api" },
];
/** A source in its colour: a subscription green, an API key amber; the words between them dim. */
const sourceHtml = (source: string) =>
  source
    .split(/(, fallback |, | or )/)
    .map((part, i) => (i % 2 === 1 ? `<span class="pmx-t-dim">${part}</span>` : `<span class="${part.endsWith("sub") ? "pmx-t-sub" : "pmx-t-api"}">${part}</span>`))
    .join("");
const piList = `<span class="pmx-t-row pmx-t-dim">/model</span>` + piRows
  .map((row) => {
    const lead = row.current ? `<span class="pmx-t-sel">→ ✓ ${row.id}</span>` : `    ${row.id}`;
    return `<span class="pmx-t-row">${lead} <span class="pmx-t-dim">(${row.name} · </span>${sourceHtml(row.source)}<span class="pmx-t-dim">)</span> <span class="pmx-t-dim">[provimux]</span></span>`;
  })
  .join("");
---

<Provimux
  title="Provimux · One key for every AI account"
  description="A self-hosted AI gateway: one OpenAI-, Claude- and Gemini-compatible endpoint for your API keys and accounts, with the prompt cache kept in use and the account behind every answer shown."
  path="/"
>
  <section class="pmx-hero">
    <div class="pmx-page">
      <p class="eyebrow pmx-eyebrow">Open source (MIT) · built on <a href={cliproxyapi}>CLIProxyAPI</a></p>
      <h1>One key for every AI account.</h1>
      <p class="pmx-lead">
        A self-hosted AI gateway: one OpenAI-, Claude- and Gemini-compatible endpoint for your API keys and accounts, with the prompt cache kept in use and the
        account behind every answer shown.
      </p>
      <p class="pmx-sub">
        Your subscriptions and API keys behind one endpoint, open to everyone you choose. Run it on your own machine or on a server your team shares, give each
        person their own client key, and point their tools at it.
      </p>
      <div class="pmx-cta">
        <div class="pmx-command" role="group" aria-label="Install with Homebrew">
          <code><span aria-hidden="true" class="pmx-prompt">$</span> {install}</code>
          <button type="button" class="copy" data-copy={install} aria-label="Copy the install command">Copy</button>
        </div>
        <a class="button primary" href="#install">Install</a>
        <a class="button" href="#adds">What it adds</a>
      </div>
      <p class="hint pmx-cta-note">macOS and Linux with Homebrew; Docker, release archives and source too. An existing CLIProxyAPI setup works as it is.</p>

      <figure class="pmx-shot pmx-shot-hero">
        <div class="pmx-frame">
          <Fragment set:html={["light", "dark"].map((scheme) => `<img class="shot-${scheme}" src="/media/console-${accounts.page}-${scheme}.webp" srcset="/media/console-${accounts.page}-${scheme}.webp 1440w, /media/console-${accounts.page}-${scheme}-2x.webp 2880w" sizes="(min-width: 1260px) 1180px, 100vw" width="1440" height="1100" alt="${accounts.alt}" decoding="async"${scheme === "dark" ? ' loading="lazy"' : ""}>`).join("")} />
        </div>
        <figcaption>The console's <strong>Accounts</strong> page: every subscription and API key in one place, whether each one works now, and which one Provimux tries first. Example data.</figcaption>
      </figure>
    </div>
  </section>

  <section id="adds" class="pmx-section" aria-labelledby="adds-title">
    <div class="pmx-page">
      <header class="pmx-head">
        <h2 id="adds-title">What Provimux adds to CLIProxyAPI</h2>
        <p>
          Each Provimux release is a <a href={cliproxyapi}>CLIProxyAPI</a> release with Provimux's changes on top. It reads the same <code>config.yaml</code>, auth folder
          (<code>~/.cli-proxy-api</code>) and port (8317), so an existing CLIProxyAPI setup works as it is: stop CLIProxyAPI and start Provimux in its place.
        </p>
      </header>

      <div class="pmx-compare" role="table" aria-label="What CLIProxyAPI does, and what Provimux does instead">
        <div class="pmx-compare-head" role="row">
          <span role="columnheader"><span class="sr-only">Topic</span></span>
          <span role="columnheader">CLIProxyAPI</span>
          <span role="columnheader" class="pmx-col-pmx">Provimux</span>
        </div>
        {groups.map((group) => (
          <div class="pmx-group" role="rowgroup">
            <p class="pmx-group-title" role="row"><span role="cell"><strong>{group.title}</strong> {group.promise}</span></p>
            {group.rows.map((row) => (
              <div class="pmx-row" role="row">
                <h3 role="rowheader">{row.topic}</h3>
                <p role="cell" class="pmx-cpa"><span class="pmx-label">CLIProxyAPI</span><span set:html={row.cpa} /></p>
                <p role="cell" class="pmx-pmx"><span class="pmx-label">Provimux</span><span set:html={row.pmx} /></p>
              </div>
            ))}
          </div>
        ))}
      </div>

      <div class="pmx-notes">
        <p>
          <strong>Everything else is CLIProxyAPI's.</strong> The logins, the providers, the translation between formats and the routing are its work. The requests
          Provimux sends to providers are CLIProxyAPI's, except where a row above says otherwise, and providers see the same client version as with CLIProxyAPI.
        </p>
        <p>
          <strong>Releases follow CLIProxyAPI's.</strong> A workflow checks for a new CLIProxyAPI release every 3 hours, moves Provimux onto it, builds and tests it,
          and publishes it on its own when the check passes; a release that fails a check waits for the maintainer. A version names its base: <code>v8.1.2-pmx.1</code> is CLIProxyAPI 8.1.2 with Provimux build 1. <a href={`${github}/releases/latest`}>Latest release</a>
        </p>
      </div>
    </div>
  </section>

  <section id="pools" class="pmx-section" aria-labelledby="pools-title">
    <div class="pmx-page pmx-pool">
      <div class="pmx-pool-text">
        <header class="pmx-pool-head">
          <p class="pmx-kicker">Pools</p>
          <h2 id="pools-title">One name, every account that can serve it.</h2>
          <p>
            Give a name of your own, such as <code>opus</code>, and put models from any of your accounts under it: a Claude subscription, an Anthropic API key,
            Devin, OpenRouter. Your tools ask for that one name. Provimux sends each request to one of the accounts behind it, in your order, and tells your tool
            which one answered.
          </p>
        </header>
        <ul class="pmx-list pmx-pool-points">
          <li>
            <strong>Made on the console's Models page:</strong> New name, a model from each account, save.
            Until then <code>claude-opus-5-5</code>, <code>devin/claude-opus-5-5</code> and <code>anthropic/claude-opus-5.5</code> are three names, and a request
            for one never reaches the accounts behind the others.
          </li>
          <li>
            <strong>Tried in your order.</strong> The highest priority first, and accounts of the same priority share the requests. An account cooling down
            after a refused request or a spent quota is skipped until its cooldown ends. Priorities are yours, one per account for all its models; nothing is
            chosen by price or speed.
          </li>
          <li>
            <strong>The answer names its account</strong> in its headers, also after a retry on another account, and <span class="whitespace-nowrap">pi-provimux</span> shows it in pi's footer.
          </li>
        </ul>
        <p class="hint pmx-pool-note">
          The routing is CLIProxyAPI's: one name on several accounts, tried by priority. Provimux adds the page that makes a pool in one save, and the headers
          that name the account. In the console, pools are among <em>Your names</em>, which also holds short names for a single model.
        </p>
      </div>
      <div class="pmx-pool-shots">
        <figure class="pmx-shot pmx-pool-shot">
          <div class="pmx-frame pmx-frame-crop">
            <Fragment set:html={cropPictures(pool)} />
          </div>
          <figcaption>
            <strong>opus</strong> on the Models page, its accounts in the order Provimux tries them. The Claude subscription is cooling down after its quota ran
            out, so the next request goes to Devin; the two API keys share third place. Example data.
          </figcaption>
        </figure>
        <figure class="pmx-term pmx-pool-answer" aria-label="Example: the answer to a request for opus names the account that gave it">
          <div class="pmx-term-bar" aria-hidden="true"><span></span><span></span><span></span><em>a request for opus</em></div>
          <pre><code><span class="pmx-t-dim">→ POST /v1/chat/completions</span>  <span class="pmx-t-dim">model:</span> <span class="pmx-t-sel">opus</span>
<span class="pmx-t-dim">← 200 OK</span>
  X-CPA-AUTH-KIND: <span class="pmx-t-sub">oauth</span>
  X-CPA-AUTH-PROVIDER: <span class="pmx-t-sub">devin</span></code></pre>
          <p class="pmx-term-foot"><span class="pmx-t-dim">pi footer</span> answered: <span class="pmx-t-sub">Devin sub</span></p>
          <figcaption class="sr-only">An example, not a real account.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="console" class="pmx-section" aria-labelledby="console-title">
    <div class="pmx-page">
      <header class="pmx-head">
        <h2 id="console-title">The console</h2>
        <p>
          <a href="https://github.com/ngvoicu/provimux-ui">provimux-ui</a> is CLIProxyAPI's Management Center in the providers.dev look, with Provimux's own pages.
          Nothing to install: Provimux downloads the latest release at startup and every 3 hours, and installs it only when it matches the release's <code>checksums.txt</code>.
        </p>
      </header>
      <ul class="pmx-list pmx-console-list">
        <li><strong>Models.</strong> Every model name your tools can send, and what serves it, in the order Provimux tries: subscription or API key, the account, the model sent, its priority, a recorded cooldown and the age of each login's own list.</li>
        <li><strong>Accounts.</strong> Every subscription and API key on one page, one card per service, each with its state in one word (Working, Signed out, Cooling down), its priority, and the fix where one is needed.</li>
        <li><strong>Your names.</strong> Short names, and <a href="#pools">pools</a>: one name served by several accounts. Saved in one action.</li>
        <li><strong>Savings.</strong> Daily usage totals kept across restarts and estimated at public list prices: what prompt caching was worth, and what the paid keys cost. <a href="#savings">More below</a>.</li>
      </ul>
      <figure class="pmx-shot pmx-shot-wide">
        <div class="pmx-frame">
          <Fragment set:html={["light", "dark"].map((scheme) => `<img class="shot-${scheme}" src="/media/console-${models.page}-${scheme}.webp" srcset="/media/console-${models.page}-${scheme}.webp 1440w, /media/console-${models.page}-${scheme}-2x.webp 2880w" sizes="(min-width: 1260px) 1180px, 100vw" width="1440" height="1100" alt="${models.alt}" decoding="async" loading="lazy">`).join("")} />
        </div>
        <figcaption>The <strong>Models</strong> page: each name with the accounts behind it, in the order Provimux tries them. On a plain CLIProxyAPI the console runs too, and Provimux's own pages hide themselves. Example data.</figcaption>
      </figure>
    </div>
  </section>

  <section id="savings" class="pmx-section" aria-labelledby="savings-title">
    <div class="pmx-page">
      <header class="pmx-head">
        <p class="pmx-kicker">Savings</p>
        <h2 id="savings-title">What prompt caching was worth, and what the paid keys cost.</h2>
        <p>
          Provimux adds up every request into daily totals, kept across restarts, and values them at public list prices. The console's Savings page shows what
          prompt caching was worth, how many requests subscriptions and API keys served, what the subscription requests would have cost on an API key, and what
          the API keys cost.
        </p>
      </header>
      <figure class="pmx-shot pmx-shot-wide pmx-savings-shot">
        <div class="pmx-frame pmx-frame-crop">
          <Fragment set:html={cropPictures(savings)} />
        </div>
        <figcaption>
          The <strong>Savings</strong> page for this month: the worth of prompt caching, its part on API keys and its part on subscriptions, the requests each kind
          served, and what the API keys cost as OpenRouter reported it. Example data.
        </figcaption>
      </figure>
      <ul class="pmx-list pmx-savings-list">
        <li>
          <strong>Estimates, said to be estimates.</strong> Valued at the base list prices of the day each request was recorded: OpenRouter's public list, and
          Provimux's own table for models it lacks; long-context tiers are not applied. The worth of caching is net of what writing the cache cost, so it can
          be negative.
        </li>
        <li>
          <strong>Money on a key, quota on a subscription.</strong> On an API key, caching saves money. On a subscription it saves quota, and its value at list
          price is shown apart. Provimux does not know what a subscription costs, so it never says what one saved.
        </li>
        <li>
          <strong>A charge the provider reported,</strong> where one reports it (OpenRouter), beside the estimate.
        </li>
        <li>
          <strong>By day, model, provider and host, and client key.</strong> A client key shows no more than its last 4 characters. One button copies a line to
          share: <em>Prompt caching through Provimux was worth $972 this month at base API list prices.</em>
        </li>
        <li>
          <strong>One request out.</strong> To have prices, Provimux downloads OpenRouter's public model list, at most every 3 hours and only while it records
          requests. No key and nothing about your installation is sent.
        </li>
      </ul>
    </div>
  </section>

  <section id="install" class="pmx-section" aria-labelledby="install-title">
    <div class="pmx-page">
      <header class="pmx-head">
        <h2 id="install-title">Install</h2>
        <p>With Homebrew on macOS (Apple silicon and Intel) and Linux (x64 and Arm), from the tap <a href="https://github.com/ngvoicu/homebrew-tap">ngvoicu/homebrew-tap</a>:</p>
      </header>
      <div class="pmx-install">
        <div class="pmx-install-main">
          <div class="pmx-code">
            <pre><code>brew install ngvoicu/tap/provimux
brew services start provimux</code></pre>
            <button type="button" class="copy" data-copy={`${install}\nbrew services start provimux`} aria-label="Copy the two commands">Copy</button>
          </div>
          <p>
            The config is <code>$(brew --prefix)/etc/provimux.conf</code>, created on the first install and never overwritten. Then open the console at <code>http://127.0.0.1:8317/management.html</code> on the same machine (from another machine, use the server's address) and sign in with your management key, <code>management.secret-key</code> in the config.
          </p>
          <h3>Coming from CLIProxyAPI with Homebrew</h3>
          <p>Stop its service (both listen on port 8317) and point Provimux at its config:</p>
          <div class="pmx-code">
            <pre><code>brew services stop cliproxyapi
ln -sf "$(brew --prefix)/etc/cliproxyapi.conf" "$(brew --prefix)/etc/provimux.conf"
brew services start provimux</code></pre>
          </div>
        </div>
        <div class="pmx-cards">
          <section class="pmx-card" aria-labelledby="other-ways">
            <h3 id="other-ways">Other ways</h3>
            <ul>
              <li><strong>Docker:</strong> <code>ghcr.io/ngvoicu/provimux</code>, linux/amd64 and linux/arm64, with CLIProxyAPI's paths: a CLIProxyAPI <code>docker-compose.yml</code> works with only the image name changed.</li>
              <li><strong>Release archives</strong> for macOS, Windows, Linux and FreeBSD, each release with its <code>checksums.txt</code>.</li>
              <li><strong>From source,</strong> with Go.</li>
            </ul>
            <p><a href={`${github}#install`}>Every way, step by step</a></p>
          </section>
          <section class="pmx-card" aria-labelledby="for-a-team">
            <h3 id="for-a-team">For a team</h3>
            <p>
              Run it on a server the team can reach and point everyone's tools at <code>http://&lt;your-server&gt;:8317</code>. Each person gets their own client key
              under <code>access.api-keys</code>; removing it shuts out only that person. Outside a network you trust, serve HTTPS.
            </p>
            <p><a href={`${github}#for-a-team`}>Setting it up for a team</a></p>
          </section>
          <section class="pmx-card" aria-labelledby="your-accounts">
            <h3 id="your-accounts">Your accounts</h3>
            <p>
              Add API keys under <code>api-keys</code>: <code>claude</code>, <code>codex</code> (OpenAI), <code>gemini</code>, <code>vertex</code>, <code>xai</code>, <code>meta</code>, and <code>openai-compatibility</code> for OpenRouter and other OpenAI-compatible services. For a company, use API keys and cloud accounts
              (for example Vertex), billed to the company under its own agreement with the provider.
            </p>
            <p class="hint">
              Provimux also accepts subscription logins (<code>oauth</code>) for your own account. Whether a provider allows a third-party tool to use its subscription
              login is that provider's decision: Anthropic's terms do not allow it, and OpenAI has not authorized it. Read your provider's terms before you add a login;
              the account is yours and so is the risk. Provimux is not affiliated with or endorsed by Anthropic or OpenAI.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section id="pi" class="pmx-section" aria-labelledby="pi-title">
    <div class="pmx-page pmx-split pmx-split-pi">
      <div class="pmx-split-text">
        <p class="pmx-kicker">For <a href="https://pi.dev">pi</a></p>
        <h2 id="pi-title">pi-provimux</h2>
        <p>
          Provimux's extension for pi. It adds Provimux as a provider in pi, <code>provimux</code>, and works the same with plain CLIProxyAPI: every model your server
          serves appears in <code>/model</code>, with its context window, reasoning levels and, when models.dev knows it, its price.
        </p>
        <ul class="pmx-list">
          <li><strong>Where each model comes from, in its name:</strong> <code>Claude Opus 5.5 · Anthropic sub, fallback api</code>. <code>sub</code> is a subscription login, <code>api</code> an API key. Accounts of the same priority are joined by <code>or</code>, and the others follow <code>fallback</code>, highest priority first.</li>
          <li><strong>Which route answered, in the footer,</strong> after each answer: <code>answered: Devin sub</code>. This needs Provimux 8.1.1-pmx.1 or newer.</li>
          <li><strong>Claude models in Claude's own format</strong> (<code>/v1/messages</code>) where it is safe: with pi's long cache retention, that brings Anthropic's 1-hour prompt cache.</li>
        </ul>
        <div class="pmx-code">
          <pre><code>pi install npm:pi-provimux</code></pre>
          <button type="button" class="copy" data-copy="pi install npm:pi-provimux" aria-label="Copy the pi install command">Copy</button>
        </div>
        <p>
          Then, in pi, run <code>/login Provimux</code> and enter your server's address (for example <code>http://127.0.0.1:8317</code>) and your client key. It needs
          pi 1.6.0 or newer.
        </p>
        <p class="pmx-links">
          <a class="button" href="https://www.npmjs.com/package/pi-provimux">pi-provimux on npm</a>
          <a class="button" href="https://github.com/ngvoicu/pi-provimux">Source on GitHub</a>
        </p>
        <p class="hint">A fork of router-for-me's <a href="https://github.com/router-for-me/pi-cliproxyapi-provider">pi-cliproxyapi-provider</a>.</p>
      </div>
      <figure class="pmx-term" aria-label="Example: pi's model list and footer with pi-provimux">
        <div class="pmx-term-bar" aria-hidden="true"><span></span><span></span><span></span><em>pi</em></div>
        <pre class="pmx-term-rows"><code set:html={piList} /></pre>
        <p class="pmx-term-foot"><span class="pmx-t-dim">footer</span> answered: <span class="pmx-t-sub">Devin sub</span></p>
        <figcaption class="sr-only">An example, not a real account.</figcaption>
      </figure>
    </div>
  </section>

  <section id="cache-keeper" class="pmx-section" aria-labelledby="cache-keeper-title">
    <div class="pmx-page">
      <header class="pmx-head">
        <p class="pmx-kicker">Also for pi</p>
        <h2 id="cache-keeper-title">pi-cache-keeper</h2>
        <p>
          A pi extension that makes the prompt cache pay off. It compacts a session by reading the cache the session already built, compacts when the context
          gets full and just before the cache expires, can keep the cache warm through a break, and fills in what pi doesn't know about a model from
          providers.dev.
        </p>
      </header>
      <ol class="pmx-fit" aria-label="How providers.dev, Provimux and pi-cache-keeper fit together">
        <li>
          <span class="pmx-fit-who"><a href="https://providers.dev">providers.dev</a></span>
          <strong>Measures.</strong>
          <span>Each model's input window, cache lifetimes and prices, at each provider and for each way in (API key or subscription login), measured values first.</span>
        </li>
        <li>
          <span class="pmx-fit-who">Provimux</span>
          <strong>Carries every account behind one key.</strong>
          <span>And, through pi-provimux, tells pi which accounts serve each model and which one answered.</span>
        </li>
        <li>
          <span class="pmx-fit-who">pi-cache-keeper</span>
          <strong>Acts on it in pi.</strong>
          <span>It looks each model up as the account that serves it, so the countdown, keeping warm and compacting follow that account's cache; when another account answers, the footer says so and follows it.</span>
        </li>
      </ol>
      <ul class="pmx-list pmx-keeper-list">
        <li><strong>Compacts from the warm cache:</strong> the summary reads about 99% of the conversation from the cache, and it sees all the tool output.</li>
        <li><strong>Compacts when the context is full,</strong> and just before the cache expires when you step away, so your next message doesn't pay to write the whole session again.</li>
        <li><strong>Keeps the cache warm through a break,</strong> for up to as long as you choose, and stops once refreshing has cost as much as one cache miss. Off until you set it.</li>
        <li><strong>Model data from providers.dev:</strong> one safe value per quantity (input window, output limit, cache lifetimes and prices), measured values first.</li>
        <li><strong>In the footer:</strong> how long the cache stays warm, the cache lifetimes and the one in use, the price, and what went wrong, such as <code>⚠ answered by an API key</code>.</li>
      </ul>
      <div class="pmx-keeper-install">
        <div class="pmx-code">
          <pre><code>pi install npm:pi-cache-keeper</code></pre>
          <button type="button" class="copy" data-copy="pi install npm:pi-cache-keeper" aria-label="Copy the pi-cache-keeper install command">Copy</button>
        </div>
        <p class="pmx-links">
          <a class="button primary" href="https://pi-cache-keeper.providers.dev/">pi-cache-keeper.providers.dev</a>
          <a class="button" href="https://www.npmjs.com/package/pi-cache-keeper">pi-cache-keeper on npm</a>
        </p>
      </div>
      <p class="hint pmx-keeper-note">
        Then run <code>/reload</code> in pi; it needs pi 1.6.0 or newer. Based on Nico Bailon's <a href="https://github.com/nicobailon/pi-cached-compaction">pi-cached-compaction</a> (MIT).
      </p>
    </div>
  </section>

