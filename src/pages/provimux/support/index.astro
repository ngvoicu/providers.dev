---
// provimux.providers.dev/support/: the support plans. The text is SupportBody, shared with /api/v1/docs/support.
import Provimux from "../../../layouts/Provimux.astro";
import SupportBody from "../../../components/provimux/SupportBody.astro";
import { PROVIMUX_SITE, SUPPORT } from "../../../core/provimux-site.ts";
import { productPage } from "../../../core/structured-data.ts";

const title = "Support · Provimux";
// A page and its trail (Provimux, then Support, as above its h1). The plans are the owner's to sell: no offer in it.
const jsonLd = productPage(PROVIMUX_SITE, "/support/", { title, description: SUPPORT.description }, [["Provimux", `${PROVIMUX_SITE}/`], [SUPPORT.title, `${PROVIMUX_SITE}/support/`]]);
---

<Provimux title={title} description={SUPPORT.description} path="/support/" jsonLd={jsonLd}>
  <div class="pmx-page pmx-doc">
    <header class="prose">
      <p class="pmx-kicker"><a href="/">Provimux</a></p>
      <h1>{SUPPORT.title}</h1>
      <p class="lead !mt-3">{SUPPORT.lead}</p>
    </header>
    <nav class="pmx-toc" aria-label="On this page">
      {SUPPORT.toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
    </nav>
    <SupportBody home="/" />
  </div>
</Provimux>
