{
 "id": "nova",
 "name": "Nova",
 "doc": "https://nova.amazon.com/dev/documentation",
 "env": [
  "NOVA_API_KEY"
 ],
 "models": {
  "nova-2-lite-v1": {
   "id": "nova-2-lite-v1",
   "name": "Nova 2 Lite",
   "description": "Multimodal reasoning model for visual analysis, planning, and tool use",
   "type": "chat",
   "family": "nova",
   "canonical_id": "amazon/nova-2-lite-v1",
   "release_date": "2025-12-02",
   "limit": {
    "context": 1000000,
    "output": 64000
   },
   "capabilities": {
    "temperature": true,
    "top_k": true,
    "top_p": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "toggle": true,
     "effort": [
      "low",
      "medium",
      "high"
     ]
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0
     },
     "output": {
      "price": 0,
      "reasoning": 0
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image/png",
     "image/jpeg",
     "image/gif",
     "image/webp",
     "video/mp4",
     "video/quicktime",
     "video/x-matroska",
     "video/webm",
     "video/x-flv",
     "video/mpeg",
     "video/x-ms-wmv",
     "video/3gpp",
     "application/pdf"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.nova.amazon.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   },
   "open_weights": false,
   "knowledge": "2025-10",
   "last_updated": "2025-12-02"
  },
