{
 "id": "paraloncloud",
 "name": "ParalonCloud",
 "doc": "https://paraloncloud.com/docs/inference-api",
 "env": [
  "PARALONCLOUD_API_KEY"
 ],
 "models": {
  "qwen3.8-27b": {
   "id": "qwen3.8-27b",
   "name": "Qwen3.8 27B",
   "description": "Dense 27B vision-language model for coding, agent tasks, and image and video understanding",
   "type": "chat",
   "family": "qwen",
   "canonical_id": "alibaba/qwen3.8-27b",
   "release_date": "2026-08-14",
   "limit": {
    "context": 131072,
    "output": 32768
   },
   "capabilities": {
    "temperature": true,
    "top_k": true,
    "top_p": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "toggle": true
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0.12
     },
     "output": {
      "price": 1.7,
      "reasoning": 1.7
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image/bmp",
     "image/jpeg",
     "image/png",
     "image/tiff",
     "image/webp",
     "image/heic"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://paraloncloud.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   },
   "open_weights": true,
   "last_updated": "2026-08-14"
  }
 }
}
