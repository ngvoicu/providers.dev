{
 "id": "therouter",
 "name": "TheRouter",
 "doc": "https://therouter.ai/docs/quickstart/",
 "env": [
  "THEROUTER_API_KEY"
 ],
 "models": {
  "openai/gpt-4o-mini": {
   "id": "openai/gpt-4o-mini",
   "name": "GPT-4o mini",
   "description": "Small omni GPT for cheap multimodal assistance and production-scale traffic",
   "type": "chat",
   "family": "gpt-mini",
   "canonical_id": "openai/gpt-4o-mini",
   "release_date": "2024-07-18",
   "limit": {
    "context": 128000,
    "output": 16384
   },
   "capabilities": {
    "temperature": true,
    "top_k": false,
    "top_p": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": false
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0.162
     },
     "output": {
      "price": 0.648
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "image/gif",
     "image/webp"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.therouter.ai/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   },
   "open_weights": false,
   "knowledge": "2023-09",
   "last_updated": "2024-07-18"
  }
 }
}
