{
 "id": "cedarllm",
 "name": "CedarLLM",
 "doc": "https://cedarllm.com/docs",
 "env": [
  "CEDARLLM_API_KEY"
 ],
 "models": {
  "qwen3.8-27b": {
   "id": "qwen3.8-27b",
   "name": "Qwen3.8 27B",
   "description": "Dense 27B vision-language model for coding, agent tasks, and image and video understanding",
   "type": "chat",
   "family": "qwen",
   "canonical_id": "alibaba/qwen3.8-27b",
   "release_date": "2026-08-14",
   "limit": {
    "context": 262144,
    "output": 32768
   },
   "capabilities": {
    "cache": {
     "implicit": true
    },
    "temperature": true,
    "top_k": true,
    "top_p": true,
    "structured_output": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "toggle": true,
     "default": {
      "type": "toggle",
      "value": false
     }
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0.03,
      "cache": {
       "read": 0.03
      }
     },
     "output": {
      "price": 1.15
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.cedarllm.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": []
      }
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     }
    }
   },
   "open_weights": true,
   "last_updated": "2026-08-14"
  }
 }
}
