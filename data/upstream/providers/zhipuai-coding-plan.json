  "glm-5.3-flash": {
   "id": "glm-5.3-flash",
   "name": "GLM-5.3-Flash",
   "type": "chat",
   "canonical_id": "zhipuai/glm-5.3-flash",
   "family": "glm-flash",
   "release_date": "2026-08-26",
   "limit": {
    "context": 1000000,
    "output": 131072
   },
   "capabilities": {
    "cache": {
     "implicit": true
    },
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "default": {
      "type": "effort",
      "value": "max"
     },
     "effort": [
      "low",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": true,
    "top_p": true,
    "top_k": false,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "Native multimodal GLM model for efficient coding and long-horizon agent tasks",
   "open_weights": true,
   "last_updated": "2026-08-26",
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "video/mp4",
     "video/x-matroska",
     "video/quicktime",
     "application/pdf"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 0,
      "cache": {
       "read": 0,
       "write": 0
      }
     },
     "output": {
      "price": 0
     }
    }
   },
   "api": {
    "chat-completions": {
     "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/zai-coding-plan/chat"
     },
     "compatibility": {
      "reasoning_field": "reasoning_content",
      "max_tokens_field": "max_tokens"
     },
     "capabilities": {
      "tools": {
       "choice": [
        "auto"
       ],
       "updates": false
      }
     }
    },
    "messages": {
     "base_url": "https://open.bigmodel.cn/api/anthropic/v1",
