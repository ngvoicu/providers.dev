    "context": 150000,
    "input": 150000,
    "output": 8192
   },
   "capabilities": {
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "toggle": true,
     "effort": [
      "none",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
     ]
    },
    "structured_output": false,
    "temperature": true,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "Multimodal model for analyzing text, images, documents, and rich media",
   "open_weights": true,
   "last_updated": "2026-07-28",
   "modalities": {
    "input": [
     "text",
     "image/png",
