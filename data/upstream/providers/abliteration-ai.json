{
 "id": "abliteration-ai",
 "name": "abliteration.ai",
 "doc": "https://docs.abliteration.ai/models",
 "env": [
  "ABLIT_KEY"
 ],
 "models": {
  "abliterated-model-large-v2": {
   "id": "abliterated-model-large-v2",
   "name": "Abliterated Model Large V2",
   "type": "chat",
   "release_date": "2026-08-29",
   "limit": {
    "context": 1000000,
    "input": 1000000,
    "output": 999990
   },
   "capabilities": {
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": true,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "GLM-5.3 model abliterated and finetuned for cyber, ML red teaming, and agent testing",
   "open_weights": false,
   "last_updated": "2026-08-31",
   "modalities": {
    "input": [
     "text"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 5,
      "cache": {
       "read": 0.5
      }
     },
     "output": {
      "price": 5
     }
    }
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.abliteration.ai/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   }
  },
  "abliterated-model": {
   "id": "abliterated-model",
   "name": "Abliterated Model",
