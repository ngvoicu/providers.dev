{
 "id": "kuae-cloud-coding-plan",
 "name": "KUAE Cloud Coding Plan",
 "doc": "https://docs.mthreads.com/kuaecloud/kuaecloud-doc-online/coding_plan/",
 "env": [
  "KUAE_API_KEY"
 ],
 "models": {
  "GLM-4.7": {
   "id": "GLM-4.7",
   "name": "GLM-4.7",
   "description": "Flagship GLM model for hybrid reasoning, coding, and agentic engineering",
   "type": "chat",
   "family": "glm",
   "canonical_id": "zhipuai/glm-4.7",
   "release_date": "2025-12-22",
   "limit": {
    "context": 204800,
    "output": 131072
   },
   "capabilities": {
    "temperature": true,
    "top_k": true,
    "top_p": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "toggle": true
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0,
      "cache": {
       "read": 0,
       "write": 0
      }
     },
     "output": {
      "price": 0
     }
    }
   },
   "modalities": {
    "input": [
     "text"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://coding-plan-endpoint.kuaecloud.net/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     }
    }
   },
   "open_weights": true,
   "knowledge": "2025-04",
   "last_updated": "2025-12-22"
  }
 }
}
