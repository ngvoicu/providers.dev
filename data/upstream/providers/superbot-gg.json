{
 "id": "superbot-gg",
 "name": "superbot",
 "doc": "https://superbot.gg/api",
 "env": [
  "SUPERBOT_API_KEY"
 ],
 "models": {
  "superbot-fast": {
   "id": "superbot-fast",
   "name": "superbot-fast",
   "description": "Quick and cheap, for small jobs. Reasoning effort low or none, a 500k-token window.",
   "type": "chat",
   "family": "deepseek-flash",
   "canonical_id": "deepseek/deepseek-v4.1-flash",
   "release_date": "2026-09-10",
   "limit": {
    "context": 500000,
    "output": 131072
   },
   "capabilities": {
    "cache": {
     "implicit": true
    },
    "temperature": true,
    "top_k": false,
    "top_p": true,
    "system_updates": false,
    "effort_updates": false,
    "service_tier": [
     "priority",
     "fast"
    ],
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "none",
      "low"
     ],
     "default": {
      "type": "effort",
      "value": "low"
     }
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 1,
      "cache": {
       "read": 0.05,
       "write": 1.25
      }
     },
     "output": {
      "price": 5,
      "reasoning": 5
     }
    },
    "multipliers": [
     {
      "when": {
       "service_tier": {
        "equals": "priority"
       }
      },
      "factor": 2
     },
     {
      "when": {
       "service_tier": {
        "equals": "fast"
       }
      },
      "factor": 2
     }
    ]
   },
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "image/gif",
     "image/webp"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.superbot.gg/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   },
   "open_weights": true,
   "knowledge": "2025-05",
   "last_updated": "2026-09-10",
   "experimental": {
    "modes": {
     "fast": {
      "service_tier": "priority",
      "body": {
       "service_tier": "priority"
      }
     }
    }
   }
  },
