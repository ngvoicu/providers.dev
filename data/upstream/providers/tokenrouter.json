{
 "id": "tokenrouter",
 "name": "TokenRouter",
 "doc": "https://www.tokenrouter.com/docs/tokenrouter-feature-guide/",
 "env": [
  "TOKENROUTER_API_KEY"
 ],
 "models": {
  "z-ai/glm-5.3-free": {
   "id": "z-ai/glm-5.3-free",
   "name": "GLM-5.3 (free)",
   "description": "Flagship GLM model for long-horizon coding, agents, and complex project delivery",
   "type": "chat",
   "family": "glm",
   "canonical_id": "zhipuai/glm-5.3",
   "release_date": "2026-08-14",
   "limit": {
    "context": 1000000,
    "output": 131072
   },
   "capabilities": {
    "temperature": true,
    "top_k": true,
    "top_p": true,
    "structured_output": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "high",
      "max"
     ]
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0
     },
     "output": {
      "price": 0
     }
    }
   },
   "modalities": {
    "input": [
     "text"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.tokenrouter.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     }
    }
   },
   "open_weights": true,
   "last_updated": "2026-08-14"
  }
 }
}
