{
 "id": "rayline",
 "name": "Rayline",
 "doc": "https://docs.rayline.ai/tools/opencode",
 "env": [
  "RAYLINE_API_KEY"
 ],
 "models": {
  "arc-sage-1.0": {
   "id": "arc-sage-1.0",
   "name": "ARC Sage",
   "description": "Rayline router tier for demanding coding and agent work",
   "type": "chat",
   "family": "ray",
   "release_date": "2026-10-21",
   "limit": {
    "context": 1000000,
    "output": 128000
   },
   "capabilities": {
    "temperature": false,
    "top_k": false,
    "top_p": false,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 1,
      "cache": {
       "read": 0.05,
       "write": 1.25
      }
     },
     "output": {
      "price": 5
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image/png",
     "image/jpeg",
     "image/webp",
     "image/gif"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "messages": {
     "base_url": "https://api.rayline.ai/v1",
     "sdk": {
      "aisdk": "@ai-sdk/anthropic",
      "opencodeai": "@opencode/ai/providers/anthropic-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   },
   "open_weights": false,
   "last_updated": "2026-10-21"
  },
