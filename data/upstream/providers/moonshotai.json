  "kimi-k3": {
   "id": "kimi-k3",
   "name": "Kimi K3",
   "type": "chat",
   "canonical_id": "moonshotai/kimi-k3",
   "family": "kimi-k3",
   "release_date": "2026-07-16",
   "limit": {
    "context": 1048576,
    "output": 1048576
   },
   "capabilities": {
    "cache": {
     "implicit": {
      "ttl": [
       "5m",
       "1h"
      ]
     }
    },
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "default": {
      "type": "effort",
      "value": "max"
     },
     "effort": [
      "low",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": false,
    "top_p": false,
    "top_k": false,
    "system_updates": true,
    "effort_updates": false,
    "stream_usage": true,
    "prompt_cache_key": true
   },
   "description": "Multimodal Kimi model with 1M context and toggleable max-effort thinking for long-horizon agent work",
   "open_weights": true,
   "last_updated": "2026-07-16",
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "image/gif",
     "image/webp",
     "image/bmp",
     "image/heic",
     "image/heif",
     "video/mp4",
     "video/mpeg",
     "video/mov",
     "video/avi",
     "video/x-flv",
     "video/mpg",
     "video/webm",
     "video/wmv",
     "video/3gpp"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 3,
      "cache": {
       "read": 0.3,
       "write": {
        "5m": 3,
        "1h": 6
       }
      }
     },
     "output": {
      "price": 15
     }
    }
   },
