{
 "id": "verda",
 "name": "Verda",
 "doc": "https://docs.verda.com/inference/quickstart/",
 "env": [
  "VERDA_INFERENCE_API_KEY"
 ],
 "models": {
  "kimi-k3-1-pro": {
   "id": "kimi-k3-1-pro",
   "name": "Kimi K3.1 Pro",
   "description": "Multimodal Kimi model with a 1M-token context window and always-on reasoning, for coding, 3D creation and financial research",
   "type": "chat",
   "family": "kimi-pro",
   "canonical_id": "moonshotai/kimi-k3.1-pro",
   "release_date": "2026-10-23",
   "limit": {
    "context": 1048576,
    "output": 1048576
   },
   "capabilities": {
    "temperature": false,
    "top_k": false,
    "top_p": false,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "high",
      "max"
     ],
     "default": {
      "type": "effort",
      "value": "max"
     }
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 2,
      "cache": {
       "read": 0.2
      }
     },
     "output": {
      "price": 10
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://inference.verda.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": []
      }
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     }
    }
   },
   "open_weights": true,
   "last_updated": "2026-10-23",
   "recommended_api": "chat-completions"
  }
 }
}
