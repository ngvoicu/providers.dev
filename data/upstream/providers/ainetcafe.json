{
 "id": "ainetcafe",
 "name": "ainetcafe",
 "doc": "https://ainetcafe.com/k3/guides/",
 "env": [
  "AINETCAFE_API_KEY"
 ],
 "models": {
  "Kimi-K3": {
   "id": "Kimi-K3",
   "name": "Kimi K3",
   "type": "chat",
   "canonical_id": "moonshotai/kimi-k3",
   "family": "kimi-k3",
   "release_date": "2026-07-16",
   "limit": {
    "context": 262144,
    "output": 32768
   },
   "capabilities": {
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": false,
    "top_p": false,
    "top_k": false,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "Multimodal Kimi model with 1M context and toggleable max-effort thinking for long-horizon agent work",
   "open_weights": true,
   "last_updated": "2026-07-16",
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "image/gif",
     "image/webp",
     "image/bmp",
     "image/heic",
     "image/heif"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 2.1,
      "cache": {
       "read": 0.3
      }
     },
     "output": {
      "price": 10.5
     }
    }
   },
   "api": {
    "chat-completions": {
     "base_url": "https://microquickjs.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   }
  }
 }
}
