{
 "id": "pareto",
 "name": "Pareto Inference",
 "doc": "https://docs.paretoinference.com/",
 "env": [
  "PARETO_API_KEY"
 ],
 "models": {
  "z-ai/glm-5.3-flash": {
   "id": "z-ai/glm-5.3-flash",
   "name": "GLM-5.3-Flash",
   "type": "chat",
   "canonical_id": "zhipuai/glm-5.3-flash",
   "family": "glm-flash",
   "release_date": "2026-08-26",
   "limit": {
    "context": 1000000,
    "output": 131072
   },
   "capabilities": {
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": true,
    "top_p": true,
    "top_k": true,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "Native multimodal GLM model for efficient coding and long-horizon agent tasks",
   "open_weights": true,
   "last_updated": "2026-08-26",
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "video/mp4",
     "video/x-matroska",
     "video/quicktime"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 0.06,
      "cache": {
       "read": 0.012
      }
     },
     "output": {
      "price": 0.2
     }
    }
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.paretoinference.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   }
  }
 }
}
