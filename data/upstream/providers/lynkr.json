{
 "id": "lynkr",
 "name": "Lynkr",
 "doc": "https://github.com/Fast-Editor/Lynkr",
 "env": [
  "LYNKR_API_KEY"
 ],
 "models": {
  "lynkr-auto": {
   "id": "lynkr-auto",
   "name": "Lynkr Auto (complexity routing)",
   "description": "Virtual model: Lynkr scores each request on complexity and routes it to the tier model the user configured (local Ollama/llama.cpp for simple requests, configured cloud providers for complex ones).",
   "type": "chat",
   "family": "auto",
   "release_date": "2025-12-03",
   "limit": {
    "context": 128000,
    "output": 8192
   },
   "capabilities": {
    "temperature": true,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": false
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0
     },
     "output": {
      "price": 0
     }
    }
   },
   "modalities": {
    "input": [
     "text"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "http://127.0.0.1:8081/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": []
      }
     }
    }
   },
   "open_weights": false,
   "last_updated": "2026-07-11"
  }
 }
}
