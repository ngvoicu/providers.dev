{
 "id": "zeldoc",
 "name": "Zeldoc",
 "doc": "https://docs.zeldoc.ai",
 "env": [
  "ZELDOC_API_KEY"
 ],
 "models": {
  "zdev": {
   "id": "zdev",
   "name": "ZDev",
   "type": "chat",
   "release_date": "2026-08-26",
   "limit": {
    "context": 1000000,
    "output": 131072
   },
   "capabilities": {
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": true,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "Coding model for repository understanding, refactors, and agentic engineering tasks",
   "open_weights": false,
   "last_updated": "2026-08-26",
   "modalities": {
    "input": [
     "text",
     "image"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 0
     },
     "output": {
      "price": 0
     }
    }
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.zeldoc.ai/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   }
  }
 }
}
