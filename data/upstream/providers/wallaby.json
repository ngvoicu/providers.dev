{
 "id": "wallaby",
 "name": "Wallaby",
 "doc": "https://wallabytoken.com/docs",
 "env": [
  "WALLABY_API_KEY"
 ],
 "models": {
  "moonshotai/kimi-k3": {
   "id": "moonshotai/kimi-k3",
   "name": "Kimi K3",
   "type": "chat",
   "canonical_id": "moonshotai/kimi-k3",
   "family": "kimi-k3",
   "release_date": "2026-07-16",
   "limit": {
    "context": 1048576,
    "output": 131072
   },
   "capabilities": {
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "effort": [
      "low",
      "medium",
      "high",
      "max"
     ]
    },
    "structured_output": true,
    "temperature": false,
    "top_p": false,
    "top_k": false,
    "system_updates": false,
    "effort_updates": false
   },
   "description": "Multimodal Kimi model with 1M context and toggleable max-effort thinking for long-horizon agent work",
   "open_weights": true,
   "last_updated": "2026-07-16",
   "modalities": {
    "input": [
     "text",
     "image/jpeg",
     "image/png",
     "image/gif",
     "image/webp",
     "image/bmp",
     "image/heic",
     "image/heif",
     "video/mp4",
     "video/mpeg",
     "video/mov",
     "video/avi",
     "video/x-flv",
     "video/mpg",
     "video/webm",
     "video/wmv",
     "video/3gpp"
    ],
    "output": [
     "text"
    ]
   },
   "cost": {
    "text": {
     "input": {
      "price": 2.7,
      "cache": {
       "read": 0.27
      }
     },
     "output": {
      "price": 13.5
     }
    }
   },
   "api": {
    "chat-completions": {
     "base_url": "https://api.wallabytoken.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     }
    }
   }
  }
 }
}
