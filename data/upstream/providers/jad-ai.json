{
 "id": "jad-ai",
 "name": "Jad AI",
 "doc": "https://jadai.freesrv.com/docs",
 "env": [
  "JAD_API_KEY"
 ],
 "models": {
  "jad-code": {
   "id": "jad-code",
   "name": "Jad Code",
   "description": "Coding-focused Jad AI model. Routes across a curated pool of strong coding models and keeps the full toolset, image input, and thinking toggle.",
   "type": "chat",
   "family": "auto",
   "release_date": "2026-11-07",
   "limit": {
    "context": 256000,
    "output": 16384
   },
   "capabilities": {
    "temperature": false,
    "system_updates": false,
    "effort_updates": false,
    "tools": {
     "supported": true
    },
    "reasoning": {
     "supported": true,
     "toggle": true,
     "default": {
      "type": "toggle",
      "value": true
     }
    }
   },
   "cost": {
    "text": {
     "input": {
      "price": 0
     },
     "output": {
      "price": 0
     }
    }
   },
   "modalities": {
    "input": [
     "text",
     "image/png",
     "image/jpeg",
     "image/webp",
     "image/gif"
    ],
    "output": [
     "text"
    ]
   },
   "api": {
    "chat-completions": {
     "base_url": "https://jadai.freesrv.com/v1",
     "sdk": {
      "aisdk": "@ai-sdk/openai-compatible",
      "opencodeai": "@opencode/ai/providers/openai-compatible"
     },
     "capabilities": {
      "tools": {
       "updates": false
      }
     },
     "compatibility": {
      "reasoning_field": "reasoning_content"
     }
    }
   },
   "open_weights": false,
   "last_updated": "2026-11-07"
  },
