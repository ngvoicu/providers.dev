{
  // The Worker renders pages from API responses; static assets hold templates and versioned snapshots.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "providers-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // One address: the apex domain. www is attached only to be redirected to it (worker/index.ts). The products' sites,
  // provimux.providers.dev and pi-cache-keeper.providers.dev, are served by the same Worker from the same build
  // (src/core/product-site.ts). No workers.dev address and no preview URLs. The account comes from the environment.
  "routes": [
    { "pattern": "providers.dev", "custom_domain": true },
    { "pattern": "www.providers.dev", "custom_domain": true },
    { "pattern": "provimux.providers.dev", "custom_domain": true },
    { "pattern": "pi-cache-keeper.providers.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
