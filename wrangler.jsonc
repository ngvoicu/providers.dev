{
  // Cloudflare Worker with static assets. Pages and data files are served as assets;
  // the Worker runs for the API (/api/v1/*) and the entry pages (/entries/*, and the old /entry/?ref= address).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "providers-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/v1/*", "/entries/*", "/entry", "/entry/"]
  }
}
